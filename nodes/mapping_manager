#!/usr/bin/env python3
"""mapping_manager — lifecycle manager for the Mapping v3 session (UI-facing).

Runs permanently (started from the vitulus_ui launch); the mapping pipeline
itself (insertion_gate + octomap_server + trajectory_dem + band_projector)
is spawned/stopped on demand as a roslaunch subprocess, one site (garden)
at a time.

Interfaces (absolute, UI-friendly):
  in   /mapping_manager/start        std_msgs/String  site name ('' = 'default')
  in   /mapping_manager/stop         std_msgs/String  (payload ignored)
  in   /mapping_manager/remove_site  std_msgs/String  site name (refuses running)
  in   /mapping_manager/show_site    std_msgs/String  site name ('' = newest) ->
                                     renders saved previews from disk
  out  /mapping_manager/status       std_msgs/String  latched JSON 1 Hz:
       {running, site, uptime_s, pid, sites: [{name, dem_kb, dem_cells?,
        rasters, has_ot, mtime}]}
  out  /mapping_manager/terrain_png  sensor_msgs/CompressedImage (latched)
  out  /mapping_manager/raster_png   sensor_msgs/CompressedImage (latched)
  out  /mapping_manager/preview_info std_msgs/String  latched JSON
  in   /mapping_manager/serve_site   std_msgs/String  '' = newest raster of
                                     newest site with any raster; '<site>' =
                                     newest raster of that site; '<site>/
                                     <raster>' = that exact raster ->
                                     publishes it as the site_map
  out  /mapping_manager/site_map     nav_msgs/OccupancyGrid  latched, for
                                     gloc_server's ~map_topic (WP1,
                                     LOCALIZATION_V2_PLAN.md)

The previews make saved maps visible in the UI at ANY time (the live
/mapping/* preview topics exist only while the pipeline runs).

A site directory is created on first start — 'new map' in the UI is just
starting with an unused name.
"""

import json
import os
import shutil
import signal
import subprocess
import time

import cv2
import numpy as np
import rospy
from nav_msgs.msg import OccupancyGrid
from sensor_msgs.msg import CompressedImage
from std_msgs.msg import String

from vitulus_mapping.demgrid import DemGrid
from vitulus_mapping.pgmio import load_occupancy_pgm
from vitulus_mapping.preview import dem_to_png


class MappingManager:
    def __init__(self):
        self.base_dir = os.path.expanduser(rospy.get_param(
            '~base_dir', '~/.vitulus/mapping_v3'))
        os.makedirs(self.base_dir, exist_ok=True)
        self.proc = None
        self.site = None
        self.started_at = None
        self.map_frame = rospy.get_param('~map_frame', 'map')
        self.serving = None    # {'site', 'raster', 'mtime'} of the last
                                # successfully published site_map, or None
        self.serve_error = None  # last serve_site rejection reason (str) for
                                 # the UI; cleared on the next successful serve
        # REPORT 2 (freeserve 2026-07-12): every stopped mapping session should be
        # immediately servable. stop_proc used to autosave ONLY the octomap (.ot),
        # never a raster, so a just-mapped site had has_ot=true / rasters=0 and
        # serve_site rejected it (serving fell back to the previously-served site
        # — the reported "cannot switch to novamapa"). With raster_on_stop, stop
        # asks band_projector to snapshot a raster (final_<timestamp>) BEFORE the
        # pipeline is killed, so the just-mapped site is servable + auto-served.
        self.raster_on_stop = bool(rospy.get_param('~raster_on_stop', True))
        # how long to wait for band_projector's snapshot before killing the
        # pipeline (regenerate loads DEM with a 2 s settle + rasters a hectare)
        self.raster_on_stop_timeout_s = float(
            rospy.get_param('~raster_on_stop_timeout_s', 25.0))
        self.pub_mapping_save = rospy.Publisher('/mapping/save', String,
                                                queue_size=1)

        self.pub_status = rospy.Publisher('/mapping_manager/status', String,
                                          queue_size=1, latch=True)
        self.pub_terrain = rospy.Publisher('/mapping_manager/terrain_png',
                                           CompressedImage, queue_size=1,
                                           latch=True)
        self.pub_raster = rospy.Publisher('/mapping_manager/raster_png',
                                          CompressedImage, queue_size=1,
                                          latch=True)
        self.pub_preview = rospy.Publisher('/mapping_manager/preview_info',
                                           String, queue_size=1, latch=True)
        self.pub_site_map = rospy.Publisher('/mapping_manager/site_map',
                                            OccupancyGrid, queue_size=1,
                                            latch=True)
        rospy.Subscriber('/mapping_manager/start', String, self.cb_start,
                         queue_size=1)
        rospy.Subscriber('/mapping_manager/stop', String, self.cb_stop,
                         queue_size=1)
        rospy.Subscriber('/mapping_manager/remove_site', String,
                         self.cb_remove, queue_size=1)
        rospy.Subscriber('/mapping_manager/show_site', String,
                         self.cb_show, queue_size=1)
        rospy.Subscriber('/mapping_manager/serve_site', String,
                         self.cb_serve_site, queue_size=1)
        rospy.Timer(rospy.Duration(1.0), self.tick_status)
        rospy.on_shutdown(self.shutdown)
        self.show_site('')            # newest saved map visible right away
        rospy.loginfo('mapping_manager up, base_dir=%s', self.base_dir)
        # Boot race fix (bootfix2, 2026-07-12): 'serving' is in-memory only, so a
        # respawn/restart leaves /mapping_manager/site_map with NO latched msg —
        # navi_man's octomap source then has nothing to republish and the whole
        # costmap/MBF chain fails to come up. Auto-serve the last-served site (from
        # the persisted .last_served state) so site_map is latched immediately at
        # boot, without waiting for anyone to send serve_site.
        self.auto_serve_last()

    # ---- lifecycle -----------------------------------------------------------
    def running(self):
        return self.proc is not None and self.proc.poll() is None

    def cb_start(self, msg):
        site = msg.data.strip() or 'default'
        if not site.replace('_', '').replace('-', '').isalnum():
            rospy.logwarn('mapping_manager: invalid site name %r', site)
            return
        if self.running():
            if site == self.site:
                rospy.loginfo('mapping_manager: %s already running', site)
                return
            self.stop_proc()
        # continue from a saved octomap archive when the site has one
        ot = os.path.join(self.base_dir, site, 'garden.ot')
        cmd = ['roslaunch', 'vitulus_mapping', 'mapping_v3.launch',
               'site:=' + site]
        if os.path.exists(ot):
            cmd.append('octomap:=' + ot)
        rospy.logwarn('mapping_manager: starting %s', ' '.join(cmd))
        self.proc = subprocess.Popen(cmd, start_new_session=True)
        self.site = site
        self.started_at = time.time()
        # servesync (2026-07-12): serving must be CONSISTENT with the active
        # mapping session. Two cases at start-of-session for site X:
        #  (a) X has rasters (continuation, e.g. garden) -> auto-serve X's newest
        #      raster so the tracker anchors on the previous version while we
        #      remap (desired). _publish_site_map also relinks the datum to X.
        #  (b) X has NO rasters (fresh site) -> CLEAR serving: publish an explicit
        #      EMPTY OccupancyGrid on site_map, status serving:null, drop
        #      .last_served. This stops the OLD site's raster from staying latched
        #      under the NEW site's datum (the reported georef mismatch). gloc's
        #      cb_grid rejects <20 occupied cells -> tracker goes no_map/idle
        #      (correct during fresh mapping); navi_man's site_map callback treats
        #      the empty grid as no-raster and falls back to its bootstrap map.
        raster = self._newest_raster_in(site)
        if raster is not None:
            rospy.loginfo('mapping_manager: start %s (continuation) — '
                          'auto-serving newest raster %s', site, raster)
            self._publish_site_map(site, raster)   # relinks datum to X
        else:
            rospy.loginfo('mapping_manager: start %s (fresh, no raster) — '
                          'clearing serving (empty site_map)', site)
            self._publish_empty_site_map()
            # DATUM INVARIANT: normally the datum symlink follows the SERVED site.
            # The one exception is an ACTIVE fresh session: there is no served
            # raster, yet insertion_gate is capturing THIS site's datum right now,
            # so the link must point at X. Relink explicitly here (the empty
            # publish does not touch the datum link).
            self.link_site_datum(site)

    def link_site_datum(self, site):
        """Point the canonical site-datum path at this site's datum.yaml so
        navi_transform picks it up (POSE_DATUM_PLAN 1b). The link may dangle
        until insertion_gate captures the georef — that is fine.

        DATUM INVARIANT (servesync 2026-07-12): the datum symlink must follow the
        SERVED site so navi_transform's fallback georef matches the raster gloc is
        localizing against. It is relinked from every serving path:
          - _publish_site_map (serve_site, stop auto-serve, stop restore-
            fallback, boot auto-serve, start continuation) -> follows the
            served site;
          - cb_start FRESH branch -> the ONE exception: no raster is served, but
            insertion_gate is capturing THIS active site's datum, so the link
            points at the active site instead.
        There is no path that serves site A while leaving the link on site B."""
        link = os.path.expanduser(rospy.get_param(
            '~site_datum_link', '~/.vitulus/saves/site_datum.yaml'))
        target = os.path.join(self.base_dir, site, 'datum.yaml')
        try:
            os.makedirs(os.path.dirname(link), exist_ok=True)
            if os.path.islink(link) or os.path.exists(link):
                os.remove(link)
            os.symlink(target, link)
            rospy.loginfo('mapping_manager: site datum link -> %s', target)
        except OSError as e:
            rospy.logwarn('mapping_manager: datum link failed: %s', e)

    def cb_stop(self, _msg):
        if not self.running():
            rospy.loginfo('mapping_manager: nothing to stop')
            return
        self.stop_proc()

    def _snapshot_raster_on_stop(self, site):
        """Ask band_projector for a full raster snapshot (final_<timestamp>)
        while the pipeline is still alive, and wait for the raster dir to
        appear. Returns the raster name on success, else None. This is what
        makes every stopped session immediately servable (REPORT 2)."""
        raster = time.strftime('final_%Y%m%d_%H%M%S')
        rasters_dir = os.path.join(self.base_dir, site, 'rasters', raster)
        pgm = os.path.join(rasters_dir, raster + '.pgm')
        rospy.loginfo('mapping_manager: raster_on_stop — snapshotting %s/%s',
                      site, raster)
        # band_projector.cb_save -> full_save(name): octomap_saver + regenerate
        # (writes the .ot AND the raster). The pipeline is still running here.
        self.pub_mapping_save.publish(String(raster))
        deadline = time.time() + self.raster_on_stop_timeout_s
        while time.time() < deadline:
            if os.path.exists(pgm):
                rospy.loginfo('mapping_manager: raster_on_stop wrote %s', pgm)
                return raster
            time.sleep(0.5)
        rospy.logwarn('mapping_manager: raster_on_stop timed out (%ss) — no '
                      'raster for %s; falling back to octomap-only save',
                      self.raster_on_stop_timeout_s, site)
        return None

    def stop_proc(self):
        rospy.logwarn('mapping_manager: stopping %s (pid %s)',
                      self.site, self.proc.pid)
        # REPORT 2: snapshot a raster BEFORE tearing the pipeline down, so the
        # just-mapped session is immediately servable (and auto-served below).
        # full_save also writes the .ot, so the octomap-only save that follows
        # is redundant on success but kept as a cheap fallback.
        if self.raster_on_stop:
            try:
                self._snapshot_raster_on_stop(self.site)
            except Exception as e:
                rospy.logwarn('mapping_manager: raster_on_stop failed: %s', e)
        # save the in-RAM octomap before killing the pipeline, so the next
        # start of this site continues instead of losing the 3D archive
        # (trajectory_dem saves its DEM on shutdown by itself)
        try:
            ot = os.path.join(self.base_dir, self.site, 'garden.ot')
            subprocess.run(['rosrun', 'octomap_server', 'octomap_saver',
                            '-f', ot, '__ns:=/mapping'],
                           check=True, timeout=60,
                           stdout=subprocess.DEVNULL,
                           stderr=subprocess.STDOUT)
            rospy.loginfo('mapping_manager: octomap saved to %s', ot)
        except Exception as e:
            rospy.logwarn('mapping_manager: octomap autosave failed: %s', e)
        try:
            # SIGINT to the whole roslaunch session for a clean node shutdown
            os.killpg(os.getpgid(self.proc.pid), signal.SIGINT)
            self.proc.wait(timeout=20)
        except Exception:
            try:
                os.killpg(os.getpgid(self.proc.pid), signal.SIGKILL)
            except Exception:
                pass
        stopped = self.site
        self.proc = None
        self.site = None
        self.started_at = None
        if stopped:
            self.show_site(stopped)   # freshly saved data -> update previews
            # datumfix (2026-07-12): auto-serve the just-mapped site so its
            # freshly-saved raster is latched on /mapping_manager/site_map (and
            # the datum symlink relinked) immediately at stop — same as boot.
            # Without this, serving stayed null until someone sent serve_site,
            # leaving the localization/costmap chain on the bootstrap map.
            if self._newest_raster_in(stopped) is not None:
                raster = self._newest_raster_in(stopped)
                rospy.loginfo('mapping_manager: auto-serving %s/%s after stop',
                              stopped, raster)
                self._publish_site_map(stopped, raster)
            else:
                # servesync (2026-07-12): the stopped session saved NO raster
                # (e.g. aborted fresh site). Serving was cleared at start (empty
                # grid), so restore it to the newest site that has a raster
                # (typically the map served before the session) instead of
                # leaving the empty grid latched. _publish_site_map also
                # re-syncs the datum symlink to the served site (invariant).
                site = self._newest_site_with_raster()
                if site is not None:
                    raster = self._newest_raster_in(site)
                    rospy.loginfo('mapping_manager: stopped %s saved no raster '
                                  '— restoring serving to %s/%s',
                                  stopped, site, raster)
                    self._publish_site_map(site, raster)
                else:
                    rospy.loginfo('mapping_manager: stopped %s saved no raster '
                                  'and no site has one — serving stays empty',
                                  stopped)

    def cb_remove(self, msg):
        site = msg.data.strip()
        path = os.path.join(self.base_dir, site)
        if not site or not os.path.isdir(path):
            return
        if self.running() and site == self.site:
            rospy.logwarn('mapping_manager: refusing to remove running site %s',
                          site)
            return
        shutil.rmtree(path)
        rospy.logwarn('mapping_manager: removed site %s', site)
        self.show_site('')

    def shutdown(self):
        if self.running():
            self.stop_proc()

    # ---- saved-map previews ---------------------------------------------------
    def cb_show(self, msg):
        self.show_site(msg.data.strip())

    def _render_site(self, site):
        """Returns (info, terrain_png_msg|None, raster_png_msg|None)."""
        d = os.path.join(self.base_dir, site)
        stamp = rospy.Time.now()
        info = {'site': site, 'terrain': False, 'raster': None}
        terrain_msg = raster_msg = None

        dem_path = os.path.join(d, 'dem.npz')
        if os.path.exists(dem_path):
            dem = DemGrid.load_npz(dem_path)
            bbox = dem.valid_bbox()
            if bbox is not None:
                x0, y0, x1, y1 = bbox
                sl = (slice(x0, x1 + 1), slice(y0, y1 + 1))
                png, zr = dem_to_png(dem.elev[sl], dem.source[sl])
                terrain_msg = CompressedImage()
                terrain_msg.header.stamp = stamp
                terrain_msg.format = 'png'
                terrain_msg.data = png
                info['terrain'] = True
                info['z_range'] = [round(z, 2) for z in zr] if zr else None
                info['area_m2'] = dem.stats()['area_traj_m2']
                # World bounds of the terrain PNG so the web UI can drop it
                # as a textured plane in the 3D view. Cell (ix,iy) min corner
                # world = (ox+ix*res, oy+iy*res); bbox is inclusive so the
                # rendered slice spans [x0 .. x1+1) cells. terrain_png is
                # dem_to_png(_orient(elev)) => image col=x asc, row=y desc.
                res = dem.res
                info['terrain_bounds'] = {
                    'min_x': round(dem.ox + x0 * res, 3),
                    'min_y': round(dem.oy + y0 * res, 3),
                    'max_x': round(dem.ox + (x1 + 1) * res, 3),
                    'max_y': round(dem.oy + (y1 + 1) * res, 3),
                }

        rasters = os.path.join(d, 'rasters')
        if os.path.isdir(rasters):
            for name in sorted(os.listdir(rasters), reverse=True):
                pgm = os.path.join(rasters, name, name + '.pgm')
                if not os.path.exists(pgm):
                    continue
                gray = cv2.imread(pgm, cv2.IMREAD_GRAYSCALE)
                if gray is None:
                    continue
                ok, buf = cv2.imencode('.png', gray)
                if not ok:
                    continue
                raster_msg = CompressedImage()
                raster_msg.header.stamp = stamp
                raster_msg.format = 'png'
                raster_msg.data = buf.tobytes()
                info['raster'] = name
                break
        return info, terrain_msg, raster_msg

    def show_site(self, site):
        """Render previews of a SAVED site from disk and publish latched —
        works with the pipeline stopped. With no site given, shows the
        newest site that actually renders something."""
        try:
            if site:
                candidates = [site]
            else:
                candidates = sorted(
                    (n for n in os.listdir(self.base_dir)
                     if os.path.isdir(os.path.join(self.base_dir, n))),
                    key=lambda n: os.path.getmtime(
                        os.path.join(self.base_dir, n)), reverse=True)
            if not candidates:
                self.pub_preview.publish(String(json.dumps(
                    {'site': None, 'terrain': False, 'raster': None})))
                return
            chosen = None
            for name in candidates:
                info, t, r = self._render_site(name)
                if t is not None or r is not None or name == candidates[-1]:
                    chosen = (info, t, r)
                    break
            info, t, r = chosen
            if t is not None:
                self.pub_terrain.publish(t)
            if r is not None:
                self.pub_raster.publish(r)
            self.pub_preview.publish(String(json.dumps(info)))
            rospy.loginfo('mapping_manager: preview %s', json.dumps(info))
        except Exception as e:
            rospy.logwarn('mapping_manager: preview failed: %s', e)

    # ---- site_map server (WP1, LOCALIZATION_V2_PLAN.md) ----------------------
    def _newest_raster_in(self, site):
        """Newest (by .pgm mtime) raster dir under <site>/rasters, or None."""
        rasters = os.path.join(self.base_dir, site, 'rasters')
        if not os.path.isdir(rasters):
            return None
        best_name, best_mtime = None, -1.0
        for name in os.listdir(rasters):
            pgm = os.path.join(rasters, name, name + '.pgm')
            if not os.path.exists(pgm):
                continue
            mtime = os.path.getmtime(pgm)
            if mtime > best_mtime:
                best_name, best_mtime = name, mtime
        return best_name

    def _newest_site_with_raster(self):
        """Newest site (by directory mtime) that has at least one raster."""
        sites = sorted(
            (n for n in os.listdir(self.base_dir)
             if os.path.isdir(os.path.join(self.base_dir, n))),
            key=lambda n: os.path.getmtime(os.path.join(self.base_dir, n)),
            reverse=True)
        for name in sites:
            if self._newest_raster_in(name) is not None:
                return name
        return None

    def cb_serve_site(self, msg):
        """'' -> newest raster of newest site with any raster; '<site>' ->
        newest raster of that site; '<site>/<raster>' -> that exact raster."""
        payload = msg.data.strip()
        try:
            if not payload:
                site = self._newest_site_with_raster()
                if site is None:
                    self._serve_reject('no site has a raster yet — Snapshot '
                                       'or Stop a mapping session first')
                    return
                raster = self._newest_raster_in(site)
            elif '/' in payload:
                site, raster = payload.split('/', 1)
            else:
                site = payload
                raster = self._newest_raster_in(site)
                if raster is None:
                    # REPORT 2(b): the common failure — site mapped (.ot) but
                    # never snapshotted, so it has no raster. Tell the UI WHY
                    # instead of a silent logwarn.
                    has_ot = os.path.exists(
                        os.path.join(self.base_dir, site, 'garden.ot'))
                    if has_ot:
                        self._serve_reject(
                            'site "%s" has no raster — press Snapshot while '
                            'mapping, or it is written automatically on Stop'
                            % site)
                    else:
                        self._serve_reject('site "%s" has no raster (and no '
                                           '3D map)' % site)
                    return
            self._publish_site_map(site, raster)
        except Exception as e:
            rospy.logerr('mapping_manager: serve_site %r failed: %s',
                         payload, e)
            self._serve_reject('serve of %r failed: %s' % (payload, e))

    def _serve_reject(self, reason):
        """Record a serve_site rejection reason for the UI and log it. The
        reason is published in the status JSON (serve_error) and shown by
        mapping.js; it is cleared on the next successful serve."""
        self.serve_error = reason
        rospy.logwarn('mapping_manager: serve_site rejected: %s', reason)
        self.tick_status(None)   # push the reason to the UI immediately

    # ---- last-served persistence (bootfix2) ---------------------------------
    def _last_served_path(self):
        return os.path.join(self.base_dir, '.last_served')

    def save_last_served(self, site, raster):
        """Persist the currently-served site/raster so we can auto-serve it on
        the next boot (survives restarts / respawns)."""
        try:
            with open(self._last_served_path(), 'w') as f:
                json.dump({'site': site, 'raster': raster}, f)
        except Exception as e:
            rospy.logwarn('mapping_manager: could not persist last_served: %s', e)

    def load_last_served(self):
        """Return (site, raster) from the persisted state, or (None, None)."""
        try:
            with open(self._last_served_path()) as f:
                d = json.load(f)
            return d.get('site'), d.get('raster')
        except Exception:
            return None, None

    def auto_serve_last(self):
        """At boot, re-serve the last-served site (if it still has a raster) so
        /mapping_manager/site_map is latched immediately. Falls back to the newest
        site with any raster. No-op (logged) when nothing has a raster yet."""
        site, raster = self.load_last_served()
        # Validate the persisted raster still exists; otherwise refresh to newest.
        if site is not None:
            if raster is None or not os.path.exists(
                    os.path.join(self.base_dir, site, 'rasters', raster,
                                 raster + '.pgm')):
                raster = self._newest_raster_in(site)
        if site is None or raster is None:
            site = self._newest_site_with_raster()
            if site is not None:
                raster = self._newest_raster_in(site)
        if site is None or raster is None:
            rospy.loginfo('mapping_manager: auto_serve_last: no site has a '
                          'raster yet — site_map not served at boot')
            return
        rospy.loginfo('mapping_manager: auto-serving last site_map %s/%s at boot',
                      site, raster)
        self._publish_site_map(site, raster)

    def _publish_empty_site_map(self):
        """Publish an explicit EMPTY (header-only, 0x0) OccupancyGrid on
        /mapping_manager/site_map and clear all serving state. Used when a fresh
        site (no rasters) starts mapping: keeps serving CONSISTENT with the active
        session instead of leaving the previous site's raster latched.

        Downstream: gloc's cb_grid rejects grids with <20 occupied cells (0 here)
        -> tracker goes no_map/idle (correct while a fresh site is being mapped);
        navi_man's callback_site_map detects the empty/tiny grid and falls back to
        its truthful bootstrap map instead of the stale raster."""
        grid = OccupancyGrid()
        grid.header.stamp = rospy.Time.now()
        grid.header.frame_id = self.map_frame
        grid.info.resolution = 0.0
        grid.info.width = 0
        grid.info.height = 0
        grid.info.origin.orientation.w = 1.0
        grid.data = []
        self.pub_site_map.publish(grid)
        self.serving = None
        # Drop the persisted last-served so a respawn during the fresh session does
        # not re-latch the old raster at boot (auto_serve_last would otherwise pick
        # it up again). It gets rewritten when a real raster is next served.
        try:
            p = self._last_served_path()
            if os.path.exists(p):
                os.remove(p)
        except OSError as e:
            rospy.logwarn('mapping_manager: could not clear last_served: %s', e)
        rospy.loginfo('mapping_manager: site_map <- EMPTY (fresh session, '
                      'serving cleared)')

    def _publish_site_map(self, site, raster):
        base = os.path.join(self.base_dir, site, 'rasters', raster, raster)
        pgm_path = base + '.pgm'
        if not os.path.exists(pgm_path):
            rospy.logwarn('mapping_manager: serve_site: no such raster %s/%s',
                          site, raster)
            return
        data, resolution, origin_xy = load_occupancy_pgm(base)
        nx, ny = data.shape

        grid = OccupancyGrid()
        grid.header.stamp = rospy.Time.now()
        grid.header.frame_id = self.map_frame
        grid.info.resolution = resolution
        grid.info.width = nx
        grid.info.height = ny
        grid.info.origin.position.x = origin_xy[0]
        grid.info.origin.position.y = origin_xy[1]
        grid.info.origin.orientation.w = 1.0
        grid.data = data.T.ravel().tolist()   # row-major over y rows,
                                               # matches band_projector
        self.pub_site_map.publish(grid)

        self.serving = {'site': site, 'raster': raster,
                        'mtime': int(os.path.getmtime(pgm_path))}
        self.serve_error = None   # a successful serve clears any prior rejection
        self.save_last_served(site, raster)
        # Keep the canonical site-datum symlink following the SERVED site, not
        # just the last MAPPED one (2026-07-11 review). Previously link_site_datum
        # ran only from start_proc (mapping), so serving site A's raster to gloc
        # while the link still pointed at a previously-mapped site B left
        # navi_transform's fallback datum offset from the served map (garden vs
        # garden2 datums differ ~0.23 m / 0.9 deg). Serving now relinks too.
        self.link_site_datum(site)
        rospy.loginfo('mapping_manager: site_map <- %s/%s (%dx%d @ %.3f m)',
                      site, raster, nx, ny, resolution)

    # ---- status --------------------------------------------------------------
    def site_info(self, name):
        d = os.path.join(self.base_dir, name)
        info = {'name': name, 'dem_kb': 0, 'rasters': 0, 'has_ot': False,
                'mtime': int(os.path.getmtime(d))}
        dem = os.path.join(d, 'dem.npz')
        if os.path.exists(dem):
            info['dem_kb'] = os.path.getsize(dem) // 1024
            try:
                with np.load(dem) as f:
                    src = f['source']
                    res = float(f['res'])
                    info['dem_m2'] = round(int((src != 0).sum()) * res * res, 1)
            except Exception:
                pass
        rasters = os.path.join(d, 'rasters')
        if os.path.isdir(rasters):
            info['rasters'] = len(os.listdir(rasters))
        info['has_ot'] = any(f.endswith('.ot') for f in os.listdir(d))
        return info

    def tick_status(self, _evt):
        if self.proc is not None and self.proc.poll() is not None:
            rospy.logwarn('mapping_manager: launch exited (code %s)',
                          self.proc.returncode)
            self.proc = None
            self.site = None
            self.started_at = None
        sites = sorted(n for n in os.listdir(self.base_dir)
                       if os.path.isdir(os.path.join(self.base_dir, n)))
        status = {
            'running': self.running(),
            'site': self.site,
            'uptime_s': int(time.time() - self.started_at)
                        if self.started_at else 0,
            'pid': self.proc.pid if self.running() else None,
            'sites': [self.site_info(n) for n in sites],
            'serving': self.serving,
            'serve_error': self.serve_error,
        }
        self.pub_status.publish(String(json.dumps(status)))


if __name__ == '__main__':
    rospy.init_node('mapping_manager')
    MappingManager()
    rospy.spin()
