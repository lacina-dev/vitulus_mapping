#!/usr/bin/env python3
"""mapping_manager — lifecycle manager for the Mapping v3 session (UI-facing).

Runs permanently (started from the vitulus_ui launch); the mapping pipeline
itself (insertion_gate + octomap_server + trajectory_dem + band_projector)
is spawned/stopped on demand as a roslaunch subprocess, one site (garden)
at a time.

Interfaces (absolute, UI-friendly):
  in   /mapping_manager/start        std_msgs/String  site name ('' = 'default')
  in   /mapping_manager/stop         std_msgs/String  (payload ignored)
  in   /mapping_manager/remove_site  std_msgs/String  site name (refuses running)
  in   /mapping_manager/show_site    std_msgs/String  site name ('' = newest) ->
                                     renders saved previews from disk
  out  /mapping_manager/status       std_msgs/String  latched JSON 1 Hz:
       {running, site, uptime_s, pid, serving, previewing, sites:
        [{name, dem_kb, dem_m2?, rasters, has_ot, mtime, raster_list:
          [{name, mtime, cells_free, cells_obstacle}] up to 12 newest}]}
  out  /mapping_manager/terrain_png  sensor_msgs/CompressedImage (latched)
  out  /mapping_manager/raster_png   sensor_msgs/CompressedImage (latched)
  out  /mapping_manager/preview_info std_msgs/String  latched JSON
  in   /mapping_manager/serve_site   std_msgs/String  '' = newest raster of
                                     newest site with any raster; '<site>' =
                                     newest raster of that site; '<site>/
                                     <raster>' = that exact raster ->
                                     publishes it as the site_map
  out  /mapping_manager/site_map     nav_msgs/OccupancyGrid  latched, for
                                     gloc_server's ~map_topic (WP1,
                                     LOCALIZATION_V2_PLAN.md)
  in   /mapping_manager/preview_raster std_msgs/String  'site/raster' to show,
                                     '' to clear -> raw raster (NO edits)
  out  /mapping_manager/raster_preview nav_msgs/OccupancyGrid  latched raw
                                     raster preview (empty 0x0 grid clears)
  in   /mapping_manager/remove_raster  std_msgs/String  'site/raster' (refuses
                                     the served raster; clears preview first)

The previews make saved maps visible in the UI at ANY time (the live
/mapping/* preview topics exist only while the pipeline runs).

A site directory is created on first start — 'new map' in the UI is just
starting with an unused name.
"""

import json
import os
import shutil
import signal
import subprocess
import time

import cv2
import numpy as np
import rosnode
import rospy
import yaml
from nav_msgs.msg import OccupancyGrid
from sensor_msgs.msg import CompressedImage
from std_msgs.msg import String

from vitulus_mapping import bundle, editmask, geo
from vitulus_mapping.demgrid import DemGrid
from vitulus_mapping.pgmio import load_occupancy_pgm
from vitulus_mapping.preview import dem_to_png


class MappingManager:
    def __init__(self):
        self.base_dir = os.path.expanduser(rospy.get_param(
            '~base_dir', '~/.vitulus/mapping_v3'))
        os.makedirs(self.base_dir, exist_ok=True)
        # WP-D1: keep bundle's site root aligned with our base_dir so
        # bundle.load_edits/save_edits resolve the same <site> dirs we serve.
        bundle.SITES_ROOT = self.base_dir
        self.proc = None
        self.site = None
        self.started_at = None
        self.map_frame = rospy.get_param('~map_frame', 'map')
        self.serving = None    # {'site', 'raster', 'mtime'} of the last
                                # successfully published site_map, or None
        self.previewing = None  # {'site', 'raster'} currently PREVIEWED on
                                # /mapping_manager/raster_preview, or None
                                # (raw raster, NO edits composited)
        self.serve_error = None  # last serve_site rejection reason (str) for
                                 # the UI; cleared on the next successful serve
        self.datum_warning = None  # M9: set at Stop when the just-ended session
                                   # captured NO georef datum (UI observability)
        self._last_gate_datum = None  # M9: last {samples, captured} seen on
                                      # /mapping/gate_status
        self._dem_m2_cache = {}    # M12: name -> (mtime, dem_m2)
        # per-raster mgmt: site -> (signature, raster_list). Cached like the
        # dem_m2 cache so the 1 Hz status tick does not re-parse every raster
        # *_meta.json; the signature is the cheap (name, pgm-mtime) tuple, so a
        # new/removed raster (or a rewritten pgm) invalidates it, a meta parse
        # does not repeat while unchanged.
        self._raster_list_cache = {}
        self.session_resolution = None  # M13: resolution the active session
                                        # started with (None when stopped)
        self.session_octomap = None     # M14 (nooctomap 2026-07-19): whether the
                                        # active session runs the octomap/band
                                        # chain (True) or is direct-raster-only
                                        # (False). None when stopped. Drives the
                                        # stop flow (skip band snapshot + garden.ot
                                        # save when False) and the status JSON.
        self.edits_applied = 0     # WP-D1: number of human edits composited
                                   # onto the currently-served raster (status)
        # REPORT 2 (freeserve 2026-07-12): every stopped mapping session should be
        # immediately servable. stop_proc used to autosave ONLY the octomap (.ot),
        # never a raster, so a just-mapped site had has_ot=true / rasters=0 and
        # serve_site rejected it (serving fell back to the previously-served site
        # — the reported "cannot switch to novamapa"). With raster_on_stop, stop
        # asks band_projector to snapshot a raster (final_<timestamp>) BEFORE the
        # pipeline is killed, so the just-mapped site is servable + auto-served.
        self.raster_on_stop = bool(rospy.get_param('~raster_on_stop', True))
        # how long to wait for band_projector's snapshot before killing the
        # pipeline (regenerate loads DEM with a 2 s settle + rasters a hectare)
        self.raster_on_stop_timeout_s = float(
            rospy.get_param('~raster_on_stop_timeout_s', 25.0))
        self.pub_mapping_save = rospy.Publisher('/mapping/save', String,
                                                queue_size=1)
        # Direct-raster path (2026-07-19): snapshot the direct 2D raster into the
        # site in PARALLEL with band's, so the A/B raster is servable too. Non-
        # fatal — band's final_<ts> stays the auto-served raster.
        self.pub_mapping_save_direct = rospy.Publisher(
            '/mapping/save_direct', String, queue_size=1)

        self.pub_status = rospy.Publisher('/mapping_manager/status', String,
                                          queue_size=1, latch=True)
        self.pub_terrain = rospy.Publisher('/mapping_manager/terrain_png',
                                           CompressedImage, queue_size=1,
                                           latch=True)
        self.pub_raster = rospy.Publisher('/mapping_manager/raster_png',
                                          CompressedImage, queue_size=1,
                                          latch=True)
        self.pub_preview = rospy.Publisher('/mapping_manager/preview_info',
                                           String, queue_size=1, latch=True)
        self.pub_site_map = rospy.Publisher('/mapping_manager/site_map',
                                            OccupancyGrid, queue_size=1,
                                            latch=True)
        # WP-D1: latched list of human edits for the serving site (MAP frame),
        # republished on every edit change and on every serve.
        self.pub_edit_list = rospy.Publisher('/mapping_manager/edit_list',
                                             String, queue_size=1, latch=True)
        # per-raster mgmt: latched RAW-raster preview (NO edits composited), for
        # side-by-side comparison of raster versions in the UI 3D view. An empty
        # 0x0 grid clears it (same clears-pattern as site_map).
        self.pub_raster_preview = rospy.Publisher(
            '/mapping_manager/raster_preview', OccupancyGrid, queue_size=1,
            latch=True)
        rospy.Subscriber('/mapping_manager/start', String, self.cb_start,
                         queue_size=1)
        rospy.Subscriber('/mapping_manager/stop', String, self.cb_stop,
                         queue_size=1)
        rospy.Subscriber('/mapping_manager/remove_site', String,
                         self.cb_remove, queue_size=1)
        rospy.Subscriber('/mapping_manager/show_site', String,
                         self.cb_show, queue_size=1)
        rospy.Subscriber('/mapping_manager/serve_site', String,
                         self.cb_serve_site, queue_size=1)
        # per-raster mgmt: preview a raw raster / remove a raster.
        rospy.Subscriber('/mapping_manager/preview_raster', String,
                         self.cb_preview_raster, queue_size=1)
        rospy.Subscriber('/mapping_manager/remove_raster', String,
                         self.cb_remove_raster, queue_size=1)
        # WP-D1: human map-edit API (save/remove; edit_list is latched output).
        rospy.Subscriber('/mapping_manager/save_edit', String,
                         self.cb_save_edit, queue_size=4)
        rospy.Subscriber('/mapping_manager/remove_edit', String,
                         self.cb_remove_edit, queue_size=4)
        # M9: watch the pipeline's gate_status so Stop can tell whether the
        # session ever captured a georef datum.
        rospy.Subscriber('/mapping/gate_status', String, self.cb_gate_status,
                         queue_size=1)
        rospy.Timer(rospy.Duration(1.0), self.tick_status)
        rospy.on_shutdown(self.shutdown)
        self.show_site('')            # newest saved map visible right away
        rospy.loginfo('mapping_manager up, base_dir=%s', self.base_dir)
        # M8: a manager restart leaves self.proc None, but a previous instance
        # may have died mid-session leaving the /mapping pipeline running. Those
        # orphans hold the octomap/gate topics and collide with the next start —
        # detect and kill them ONCE at boot before declaring no session.
        self._kill_orphan_pipeline()
        # Boot race fix (bootfix2, 2026-07-12): 'serving' is in-memory only, so a
        # respawn/restart leaves /mapping_manager/site_map with NO latched msg —
        # navi_man's octomap source then has nothing to republish and the whole
        # costmap/MBF chain fails to come up. Auto-serve the last-served site (from
        # the persisted .last_served state) so site_map is latched immediately at
        # boot, without waiting for anyone to send serve_site.
        self.auto_serve_last()
        # WP-D1: ensure edit_list is latched even if nothing is served at boot
        # (auto_serve_last -> _publish_site_map already publishes it when a site
        # was restored). Republish for the restored serving site, else empty.
        if self.serving:
            self._publish_edit_list(self.serving.get('site'))
        else:
            self.pub_edit_list.publish(String(json.dumps([])))
        # per-raster mgmt: latch an empty raster_preview at boot so subscribers
        # (the UI 3D preview layer) always get an initial message.
        self._clear_preview()

    # ---- lifecycle -----------------------------------------------------------
    def running(self):
        return self.proc is not None and self.proc.poll() is None

    def cb_gate_status(self, msg):
        """M9: track the pipeline's datum-capture progress so Stop can warn on a
        session that never got a georef (no sustained RTK)."""
        try:
            s = json.loads(msg.data)
        except (ValueError, TypeError):
            return
        if 'datum_samples' in s or 'datum_captured' in s:
            self._last_gate_datum = {'samples': s.get('datum_samples', 0),
                                     'captured': bool(s.get('datum_captured'))}

    def _kill_orphan_pipeline(self):
        """M8: kill a /mapping pipeline left running by a dead previous manager
        instance (self.proc is None here, so it is not ours). Runs once at boot
        (called from __init__). Uses rosnode.kill_nodes — we do not own the
        orphans' process group, so os.killpg is not an option."""
        session_nodes = ['/mapping/insertion_gate', '/mapping/trajectory_dem',
                         '/mapping/band_projector', '/mapping/octomap_server']
        try:
            live = set(rosnode.get_node_names())
        except Exception as e:
            rospy.logwarn('mapping_manager: orphan check failed: %s', e)
            return
        orphans = [n for n in session_nodes if n in live]
        if not orphans:
            return
        rospy.logwarn('mapping_manager: found ORPHANED mapping pipeline %s with '
                      'no manager child — killing (a restart left it running)',
                      orphans)
        try:
            rosnode.kill_nodes(orphans)
        except Exception as e:
            rospy.logwarn('mapping_manager: orphan kill failed: %s', e)

    def cb_start(self, msg):
        site = msg.data.strip() or 'default'
        if not site.replace('_', '').replace('-', '').isalnum():
            rospy.logwarn('mapping_manager: invalid site name %r', site)
            return
        if self.running():
            if site == self.site:
                rospy.loginfo('mapping_manager: %s already running', site)
                return
            self.stop_proc()
        # continue from a saved octomap archive when the site has one
        ot = os.path.join(self.base_dir, site, 'garden.ot')
        # M13: per-site voxel/raster resolution (site_config.json), default 0.05.
        res = self._site_resolution(site)
        # M14 (nooctomap 2026-07-19): per-site octomap on/off (site_config.json,
        # key 'octomap', default true). False -> direct-raster-only session:
        # launch skips octomap_server + band_projector, stop skips the band
        # snapshot + garden.ot save, direct_<ts> is the served raster.
        octo = self._site_octomap(site)
        cmd = ['roslaunch', 'vitulus_mapping', 'mapping_v3.launch',
               'site:=' + site, 'resolution:=%g' % res,
               'octomap:=' + ('true' if octo else 'false')]
        # The .ot continuation archive is only consumed by octomap_server, so it
        # is meaningless (and the node is absent) when the chain is off.
        if octo and os.path.exists(ot):
            cmd.append('octomap_archive:=' + ot)
        rospy.logwarn('mapping_manager: starting %s', ' '.join(cmd))
        self.proc = subprocess.Popen(cmd, start_new_session=True)
        self.site = site
        self.started_at = time.time()
        self.session_resolution = res      # M13: report in status JSON
        self.session_octomap = octo        # M14: report in status JSON
        self.datum_warning = None          # M9: clear stale warning on new run
        self._last_gate_datum = None
        # servesync (2026-07-12): serving must be CONSISTENT with the active
        # mapping session. Two cases at start-of-session for site X:
        #  (a) X has rasters (continuation, e.g. garden) -> auto-serve X's newest
        #      raster so the tracker anchors on the previous version while we
        #      remap (desired). _publish_site_map also relinks the datum to X.
        #  (b) X has NO rasters (fresh site) -> CLEAR serving: publish an explicit
        #      EMPTY OccupancyGrid on site_map, status serving:null, drop
        #      .last_served. This stops the OLD site's raster from staying latched
        #      under the NEW site's datum (the reported georef mismatch). gloc's
        #      cb_grid rejects <20 occupied cells -> tracker goes no_map/idle
        #      (correct during fresh mapping); navi_man's site_map callback treats
        #      the empty grid as no-raster and falls back to its bootstrap map.
        raster = self._newest_raster_in(site)
        if raster is not None:
            rospy.loginfo('mapping_manager: start %s (continuation) — '
                          'auto-serving newest raster %s', site, raster)
            self._publish_site_map(site, raster)   # relinks datum to X
        else:
            rospy.loginfo('mapping_manager: start %s (fresh, no raster) — '
                          'clearing serving (empty site_map)', site)
            self._publish_empty_site_map()
            # DATUM INVARIANT: normally the datum symlink follows the SERVED site.
            # The one exception is an ACTIVE fresh session: there is no served
            # raster, yet insertion_gate is capturing THIS site's datum right now,
            # so the link must point at X. Relink explicitly here (the empty
            # publish does not touch the datum link).
            self.link_site_datum(site)

    def _site_resolution(self, site):
        """M13: per-site voxel/raster resolution from <site>/site_config.json
        (key 'resolution'), mirroring the band_overrides.json per-site pattern.
        New/legacy sites without the file default to 0.05 m, so 'garden' (whose
        garden.ot / rasters are 0.05 m) is unaffected. Out-of-range or malformed
        values fall back to the default."""
        default = float(rospy.get_param('~default_resolution', 0.05))
        cfg = os.path.join(self.base_dir, site, 'site_config.json')
        try:
            with open(cfg) as f:
                v = float(json.load(f).get('resolution', default))
            if 0.01 <= v <= 1.0:
                return v
            rospy.logwarn('mapping_manager: site_config resolution %s out of '
                          'range 0.01..1.0 for %s — using %.3f', v, site,
                          default)
        except FileNotFoundError:
            pass
        except (ValueError, TypeError, OSError) as e:
            rospy.logwarn('mapping_manager: bad site_config for %s: %s — using '
                          '%.3f', site, e, default)
        return default

    def _site_octomap(self, site):
        """M14 (nooctomap 2026-07-19): per-site octomap on/off from
        <site>/site_config.json (key 'octomap'), mirroring _site_resolution.
        Default True keeps every legacy site (garden etc.) on the octomap/band
        chain unchanged; a site with {"octomap": false} runs direct-raster-only.
        A missing file or malformed value falls back to True (safe = old
        behaviour)."""
        default = bool(rospy.get_param('~default_octomap', True))
        cfg = os.path.join(self.base_dir, site, 'site_config.json')
        try:
            with open(cfg) as f:
                return bool(json.load(f).get('octomap', default))
        except FileNotFoundError:
            pass
        except (ValueError, TypeError, OSError) as e:
            rospy.logwarn('mapping_manager: bad site_config octomap for %s: %s '
                          '— using %s', site, e, default)
        return default

    def link_site_datum(self, site):
        """Point the canonical site-datum path at this site's datum.yaml so
        navi_transform picks it up (POSE_DATUM_PLAN 1b). The link may dangle
        until insertion_gate captures the georef — that is fine.

        DATUM INVARIANT (servesync 2026-07-12): the datum symlink must follow the
        SERVED site so navi_transform's fallback georef matches the raster gloc is
        localizing against. It is relinked from every serving path:
          - _publish_site_map (serve_site, stop auto-serve, stop restore-
            fallback, boot auto-serve, start continuation) -> follows the
            served site;
          - cb_start FRESH branch -> the ONE exception: no raster is served, but
            insertion_gate is capturing THIS active site's datum, so the link
            points at the active site instead.
        There is no path that serves site A while leaving the link on site B."""
        link = os.path.expanduser(rospy.get_param(
            '~site_datum_link', '~/.vitulus/saves/site_datum.yaml'))
        target = os.path.join(self.base_dir, site, 'datum.yaml')
        try:
            os.makedirs(os.path.dirname(link), exist_ok=True)
            if os.path.islink(link) or os.path.exists(link):
                os.remove(link)
            os.symlink(target, link)
            rospy.loginfo('mapping_manager: site datum link -> %s', target)
        except OSError as e:
            rospy.logwarn('mapping_manager: datum link failed: %s', e)

    def cb_stop(self, _msg):
        if not self.running():
            rospy.loginfo('mapping_manager: nothing to stop')
            return
        self.stop_proc()

    def _snapshot_raster_on_stop(self, site, octomap=True):
        """Ask band_projector for a full raster snapshot (final_<timestamp>)
        while the pipeline is still alive, and wait for the raster dir to
        appear. Returns the raster name on success, else None. This is what
        makes every stopped session immediately servable (REPORT 2).

        M14 (nooctomap 2026-07-19): when octomap=False, band_projector is NOT
        running (direct-raster-only session), so the band final_<ts> save+wait
        is skipped entirely (no final_<ts>, no .ot). Only direct_<ts> is
        requested and waited on; it becomes the newest raster the stop path
        auto-serves."""
        # Always request the direct snapshot: it is the sole raster when octomap
        # is off, and the A/B raster when octomap is on.
        direct_name = time.strftime('direct_%Y%m%d_%H%M%S')
        direct_pgm = os.path.join(self.base_dir, site, 'rasters', direct_name,
                                  direct_name + '.pgm')
        self.pub_mapping_save_direct.publish(String(json.dumps(
            {'name': direct_name})))

        if not octomap:
            # Direct-raster-only: wait for direct_<ts> and return IT so the stop
            # path serves the direct raster (it is also the newest by mtime).
            rospy.loginfo('mapping_manager: raster_on_stop (octomap OFF) — '
                          'snapshotting direct %s/%s', site, direct_name)
            deadline = time.time() + self.raster_on_stop_timeout_s
            while time.time() < deadline:
                if os.path.exists(direct_pgm):
                    rospy.loginfo('mapping_manager: raster_on_stop wrote direct '
                                  '%s', direct_pgm)
                    return direct_name
                time.sleep(0.5)
            rospy.logwarn('mapping_manager: raster_on_stop timed out (%ss) — no '
                          'direct raster for %s (octomap off, no band fallback)',
                          self.raster_on_stop_timeout_s, site)
            return None

        raster = time.strftime('final_%Y%m%d_%H%M%S')
        rasters_dir = os.path.join(self.base_dir, site, 'rasters', raster)
        pgm = os.path.join(rasters_dir, raster + '.pgm')
        rospy.loginfo('mapping_manager: raster_on_stop — snapshotting %s/%s',
                      site, raster)
        # band_projector.cb_save -> full_save(name, write_ot=False): writes the
        # raster only. M10: we skip its final_<ts>.ot (orphan cruft) because
        # stop_proc saves garden.ot itself right after this. Pipeline still up.
        self.pub_mapping_save.publish(String(json.dumps(
            {'name': raster, 'write_ot': False})))
        # PARALLEL: direct_<ts> (already requested above) into the SAME rasters/
        # dir, so the direct 2D map is a servable A/B raster. This is fire-and-
        # forget relative to the band flow: its success/failure never changes the
        # return value (band's final_<ts> drives auto-serve).
        deadline = time.time() + self.raster_on_stop_timeout_s
        got_band = None
        got_direct = False
        while time.time() < deadline:
            if got_band is None and os.path.exists(pgm):
                rospy.loginfo('mapping_manager: raster_on_stop wrote %s', pgm)
                got_band = raster
            if not got_direct and os.path.exists(direct_pgm):
                rospy.loginfo('mapping_manager: raster_on_stop wrote direct %s',
                              direct_pgm)
                got_direct = True
            if got_band is not None and got_direct:
                return got_band
            time.sleep(0.5)
        if got_band is not None:
            if not got_direct:
                rospy.logwarn('mapping_manager: direct raster snapshot not seen '
                              'for %s (band raster saved; direct is optional A/B)',
                              site)
            return got_band
        rospy.logwarn('mapping_manager: raster_on_stop timed out (%ss) — no '
                      'band raster for %s; falling back to octomap-only save',
                      self.raster_on_stop_timeout_s, site)
        return None

    def stop_proc(self):
        # M14 (nooctomap): default True for legacy safety if a session's flag is
        # somehow unknown (e.g. adopted orphan) — preserves the old stop flow.
        octomap_on = self.session_octomap if self.session_octomap is not None \
            else True
        rospy.logwarn('mapping_manager: stopping %s (pid %s, octomap=%s)',
                      self.site, self.proc.pid, octomap_on)
        # REPORT 2: snapshot a raster BEFORE tearing the pipeline down, so the
        # just-mapped session is immediately servable (and auto-served below).
        # M10: the snapshot is raster-only (write_ot=False), so the octomap-only
        # save below is now the sole writer of garden.ot (no orphan final_*.ot).
        # M14: with octomap off, _snapshot_raster_on_stop skips the band save and
        # only snapshots+waits the direct_<ts> raster.
        if self.raster_on_stop:
            try:
                self._snapshot_raster_on_stop(self.site, octomap_on)
            except Exception as e:
                rospy.logwarn('mapping_manager: raster_on_stop failed: %s', e)
        # save the in-RAM octomap before killing the pipeline, so the next
        # start of this site continues instead of losing the 3D archive
        # (trajectory_dem saves its DEM on shutdown by itself). M14: skip when
        # octomap is off — octomap_server is not running, so octomap_saver would
        # block on a nonexistent /mapping service for the full 60 s timeout.
        if octomap_on:
            try:
                ot = os.path.join(self.base_dir, self.site, 'garden.ot')
                subprocess.run(['rosrun', 'octomap_server', 'octomap_saver',
                                '-f', ot, '__ns:=/mapping'],
                               check=True, timeout=60,
                               stdout=subprocess.DEVNULL,
                               stderr=subprocess.STDOUT)
                rospy.loginfo('mapping_manager: octomap saved to %s', ot)
            except Exception as e:
                rospy.logwarn('mapping_manager: octomap autosave failed: %s', e)
        else:
            rospy.loginfo('mapping_manager: octomap OFF this session — skipping '
                          'garden.ot autosave (direct raster is the map)')
        try:
            # SIGINT to the whole roslaunch session for a clean node shutdown
            os.killpg(os.getpgid(self.proc.pid), signal.SIGINT)
            self.proc.wait(timeout=20)
        except Exception:
            try:
                os.killpg(os.getpgid(self.proc.pid), signal.SIGKILL)
            except Exception:
                pass
        stopped = self.site
        self.proc = None
        self.site = None
        self.started_at = None
        self.session_resolution = None     # M13
        self.session_octomap = None        # M14
        # M9: warn if the session captured NO georef datum (no sustained RTK).
        # Observability only — no behavioural fallback.
        gd = self._last_gate_datum
        if gd is not None and not gd.get('captured') \
                and (gd.get('samples') or 0) == 0:
            self.datum_warning = (
                'site "%s" captured NO georef datum this session (no sustained '
                'RTK) — its map may be mislocated; remap with good GPS' % stopped)
            rospy.logwarn('mapping_manager: %s', self.datum_warning)
        else:
            self.datum_warning = None
        if stopped:
            self.show_site(stopped)   # freshly saved data -> update previews
            # datumfix (2026-07-12): auto-serve the just-mapped site so its
            # freshly-saved raster is latched on /mapping_manager/site_map (and
            # the datum symlink relinked) immediately at stop — same as boot.
            # Without this, serving stayed null until someone sent serve_site,
            # leaving the localization/costmap chain on the bootstrap map.
            if self._newest_raster_in(stopped) is not None:
                raster = self._newest_raster_in(stopped)
                rospy.loginfo('mapping_manager: auto-serving %s/%s after stop',
                              stopped, raster)
                self._publish_site_map(stopped, raster)
            else:
                # servesync (2026-07-12): the stopped session saved NO raster
                # (e.g. aborted fresh site). Serving was cleared at start (empty
                # grid), so restore it to the newest site that has a raster
                # (typically the map served before the session) instead of
                # leaving the empty grid latched. _publish_site_map also
                # re-syncs the datum symlink to the served site (invariant).
                site = self._newest_site_with_raster()
                if site is not None:
                    raster = self._newest_raster_in(site)
                    rospy.loginfo('mapping_manager: stopped %s saved no raster '
                                  '— restoring serving to %s/%s',
                                  stopped, site, raster)
                    self._publish_site_map(site, raster)
                else:
                    rospy.loginfo('mapping_manager: stopped %s saved no raster '
                                  'and no site has one — serving stays empty',
                                  stopped)

    def cb_remove(self, msg):
        site = msg.data.strip()
        # M1: validate the name (same rule cb_start uses) BEFORE building any
        # path — a payload like '..' or 'a/../..' would otherwise let rmtree
        # escape base_dir and delete ~/.vitulus/.
        if not site or not site.replace('_', '').replace('-', '').isalnum():
            rospy.logwarn('mapping_manager: refusing to remove invalid site '
                          'name %r', site)
            return
        path = os.path.join(self.base_dir, site)
        # M1: belt-and-suspenders containment — the resolved path MUST stay
        # strictly under base_dir (rejects symlink escapes too).
        real = os.path.realpath(path)
        if not real.startswith(os.path.realpath(self.base_dir) + os.sep):
            rospy.logwarn('mapping_manager: refusing to remove out-of-tree '
                          'path %s', real)
            return
        if not os.path.isdir(path):
            return
        if self.running() and site == self.site:
            rospy.logwarn('mapping_manager: refusing to remove running site %s',
                          site)
            return
        # M1: never delete the site currently being served — it would strand
        # /mapping_manager/site_map + gloc on a deleted raster. Clear serving
        # (serve another site) first.
        if self.serving and self.serving.get('site') == site:
            rospy.logwarn('mapping_manager: refusing to remove currently-'
                          'serving site %s — serve another site first', site)
            return
        shutil.rmtree(path)
        self._dem_m2_cache.pop(site, None)   # M12: drop cache for removed site
        self._raster_list_cache.pop(site, None)   # per-raster mgmt cache too
        rospy.logwarn('mapping_manager: removed site %s', site)
        self.show_site('')

    def shutdown(self):
        if self.running():
            self.stop_proc()

    # ---- saved-map previews ---------------------------------------------------
    def cb_show(self, msg):
        self.show_site(msg.data.strip())

    def _render_site(self, site):
        """Returns (info, terrain_png_msg|None, raster_png_msg|None)."""
        d = os.path.join(self.base_dir, site)
        stamp = rospy.Time.now()
        info = {'site': site, 'terrain': False, 'raster': None}
        terrain_msg = raster_msg = None

        dem_path = os.path.join(d, 'dem.npz')
        if os.path.exists(dem_path):
            dem = DemGrid.load_npz(dem_path)
            bbox = dem.valid_bbox()
            if bbox is not None:
                x0, y0, x1, y1 = bbox
                sl = (slice(x0, x1 + 1), slice(y0, y1 + 1))
                png, zr = dem_to_png(dem.elev[sl], dem.source[sl])
                terrain_msg = CompressedImage()
                terrain_msg.header.stamp = stamp
                terrain_msg.format = 'png'
                terrain_msg.data = png
                info['terrain'] = True
                info['z_range'] = [round(z, 2) for z in zr] if zr else None
                info['area_m2'] = dem.stats()['area_traj_m2']
                # World bounds of the terrain PNG so the web UI can drop it
                # as a textured plane in the 3D view. Cell (ix,iy) min corner
                # world = (ox+ix*res, oy+iy*res); bbox is inclusive so the
                # rendered slice spans [x0 .. x1+1) cells. terrain_png is
                # dem_to_png(_orient(elev)) => image col=x asc, row=y desc.
                res = dem.res
                info['terrain_bounds'] = {
                    'min_x': round(dem.ox + x0 * res, 3),
                    'min_y': round(dem.oy + y0 * res, 3),
                    'max_x': round(dem.ox + (x1 + 1) * res, 3),
                    'max_y': round(dem.oy + (y1 + 1) * res, 3),
                }

        rasters = os.path.join(d, 'rasters')
        if os.path.isdir(rasters):
            for name in sorted(os.listdir(rasters), reverse=True):
                pgm = os.path.join(rasters, name, name + '.pgm')
                if not os.path.exists(pgm):
                    continue
                gray = cv2.imread(pgm, cv2.IMREAD_GRAYSCALE)
                if gray is None:
                    continue
                ok, buf = cv2.imencode('.png', gray)
                if not ok:
                    continue
                raster_msg = CompressedImage()
                raster_msg.header.stamp = stamp
                raster_msg.format = 'png'
                raster_msg.data = buf.tobytes()
                info['raster'] = name
                break
        return info, terrain_msg, raster_msg

    def show_site(self, site):
        """Render previews of a SAVED site from disk and publish latched —
        works with the pipeline stopped. With no site given, shows the
        newest site that actually renders something."""
        try:
            if site:
                candidates = [site]
            else:
                candidates = sorted(
                    (n for n in os.listdir(self.base_dir)
                     if os.path.isdir(os.path.join(self.base_dir, n))),
                    key=lambda n: os.path.getmtime(
                        os.path.join(self.base_dir, n)), reverse=True)
            if not candidates:
                self.pub_preview.publish(String(json.dumps(
                    {'site': None, 'terrain': False, 'raster': None})))
                return
            chosen = None
            for name in candidates:
                info, t, r = self._render_site(name)
                if t is not None or r is not None or name == candidates[-1]:
                    chosen = (info, t, r)
                    break
            info, t, r = chosen
            if t is not None:
                self.pub_terrain.publish(t)
            if r is not None:
                self.pub_raster.publish(r)
            self.pub_preview.publish(String(json.dumps(info)))
            rospy.loginfo('mapping_manager: preview %s', json.dumps(info))
        except Exception as e:
            rospy.logwarn('mapping_manager: preview failed: %s', e)

    # ---- site_map server (WP1, LOCALIZATION_V2_PLAN.md) ----------------------
    def _newest_raster_in(self, site):
        """Newest (by .pgm mtime) raster dir under <site>/rasters, or None."""
        rasters = os.path.join(self.base_dir, site, 'rasters')
        if not os.path.isdir(rasters):
            return None
        best_name, best_mtime = None, -1.0
        for name in os.listdir(rasters):
            pgm = os.path.join(rasters, name, name + '.pgm')
            if not os.path.exists(pgm):
                continue
            mtime = os.path.getmtime(pgm)
            if mtime > best_mtime:
                best_name, best_mtime = name, mtime
        return best_name

    def _newest_site_with_raster(self):
        """Newest site (by directory mtime) that has at least one raster."""
        sites = sorted(
            (n for n in os.listdir(self.base_dir)
             if os.path.isdir(os.path.join(self.base_dir, n))),
            key=lambda n: os.path.getmtime(os.path.join(self.base_dir, n)),
            reverse=True)
        for name in sites:
            if self._newest_raster_in(name) is not None:
                return name
        return None

    def cb_serve_site(self, msg):
        """'' -> newest raster of newest site with any raster; '<site>' ->
        newest raster of that site; '<site>/<raster>' -> that exact raster."""
        payload = msg.data.strip()
        try:
            if not payload:
                site = self._newest_site_with_raster()
                if site is None:
                    self._serve_reject('no site has a raster yet — Snapshot '
                                       'or Stop a mapping session first')
                    return
                raster = self._newest_raster_in(site)
            elif '/' in payload:
                site, raster = payload.split('/', 1)
            else:
                site = payload
                raster = self._newest_raster_in(site)
                if raster is None:
                    # REPORT 2(b): the common failure — site mapped (.ot) but
                    # never snapshotted, so it has no raster. Tell the UI WHY
                    # instead of a silent logwarn.
                    has_ot = os.path.exists(
                        os.path.join(self.base_dir, site, 'garden.ot'))
                    if has_ot:
                        self._serve_reject(
                            'site "%s" has no raster — press Snapshot while '
                            'mapping, or it is written automatically on Stop'
                            % site)
                    else:
                        self._serve_reject('site "%s" has no raster (and no '
                                           '3D map)' % site)
                    return
            self._publish_site_map(site, raster)
        except Exception as e:
            rospy.logerr('mapping_manager: serve_site %r failed: %s',
                         payload, e)
            self._serve_reject('serve of %r failed: %s' % (payload, e))

    def _serve_reject(self, reason):
        """Record a serve_site rejection reason for the UI and log it. The
        reason is published in the status JSON (serve_error) and shown by
        mapping.js; it is cleared on the next successful serve."""
        self.serve_error = reason
        rospy.logwarn('mapping_manager: serve_site rejected: %s', reason)
        self.tick_status(None)   # push the reason to the UI immediately

    # ---- per-raster management (preview / remove) ----------------------------
    def _validate_raster_ref(self, payload):
        """Parse+validate a 'site/raster' reference with the same discipline as
        serve_site / the hardened remove_site: both name parts must be non-empty
        alnum (with _ and -), and the resolved raster dir MUST stay strictly
        under base_dir (rejects '..' / symlink escapes). Returns
        (site, raster, base) where base is the '<...>/<raster>' path prefix that
        load_occupancy_pgm consumes. Raises ValueError on any violation."""
        if '/' not in payload:
            raise ValueError('expected "site/raster"')
        site, raster = payload.split('/', 1)
        for part in (site, raster):
            if not part or not part.replace('_', '').replace('-', '').isalnum():
                raise ValueError('invalid name %r' % part)
        rdir = os.path.join(self.base_dir, site, 'rasters', raster)
        real = os.path.realpath(rdir)
        if not real.startswith(os.path.realpath(self.base_dir) + os.sep):
            raise ValueError('out-of-tree path %s' % real)
        return site, raster, os.path.join(rdir, raster)

    def _clear_preview(self):
        """Publish an explicit EMPTY (0x0) OccupancyGrid on raster_preview to
        clear the UI preview layer, and drop the previewing state. Same
        empty-grid-clears pattern as _publish_empty_site_map."""
        grid = OccupancyGrid()
        grid.header.stamp = rospy.Time.now()
        grid.header.frame_id = self.map_frame
        grid.info.resolution = 0.0
        grid.info.width = 0
        grid.info.height = 0
        grid.info.origin.orientation.w = 1.0
        grid.data = []
        self.pub_raster_preview.publish(grid)
        if self.previewing is not None:
            self.previewing = None
            rospy.loginfo('mapping_manager: raster_preview <- EMPTY (cleared)')

    def cb_preview_raster(self, msg):
        """Show a RAW raster (pgm+yaml, NO edits composited — raw is the point
        of comparison) latched on /mapping_manager/raster_preview. Payload
        'site/raster' to show, '' to clear. Validation mirrors serve_site."""
        payload = msg.data.strip()
        if not payload:
            self._clear_preview()
            self.tick_status(None)
            return
        try:
            site, raster, base = self._validate_raster_ref(payload)
        except ValueError as e:
            self._serve_reject('preview: %s' % e)
            return
        if not os.path.exists(base + '.pgm'):
            self._serve_reject('preview: no such raster %s' % payload)
            return
        try:
            data, resolution, origin_xy = load_occupancy_pgm(base)
        except Exception as e:
            self._serve_reject('preview: load failed for %s: %s'
                               % (payload, e))
            return
        nx, ny = data.shape
        grid = OccupancyGrid()
        grid.header.stamp = rospy.Time.now()
        grid.header.frame_id = self.map_frame
        grid.info.resolution = resolution
        grid.info.width = nx
        grid.info.height = ny
        grid.info.origin.position.x = origin_xy[0]
        grid.info.origin.position.y = origin_xy[1]
        grid.info.origin.orientation.w = 1.0
        grid.data = data.T.ravel().tolist()   # row-major over y, matches serve
        self.pub_raster_preview.publish(grid)
        self.previewing = {'site': site, 'raster': raster}
        rospy.loginfo('mapping_manager: raster_preview <- %s (%dx%d @ %.3f m)',
                      payload, nx, ny, resolution)
        self.tick_status(None)   # push previewing to the UI immediately

    def cb_remove_raster(self, msg):
        """Delete a single raster dir. Refuses the currently SERVED raster;
        clears the preview first if it targets the removed raster. Name
        validation + realpath containment (hardened remove_site discipline),
        then shutil.rmtree, then republish status."""
        payload = msg.data.strip()
        try:
            site, raster, base = self._validate_raster_ref(payload)
        except ValueError as e:
            self._serve_reject('remove_raster: %s' % e)
            return
        rdir = os.path.join(self.base_dir, site, 'rasters', raster)
        if not os.path.isdir(rdir):
            self._serve_reject('remove_raster: no such raster %s' % payload)
            return
        # never delete the raster gloc/costmaps are localizing against
        if self.serving and self.serving.get('site') == site \
                and self.serving.get('raster') == raster:
            self._serve_reject('cannot delete the SERVED raster %s — serve '
                               'another first' % payload)
            return
        # clearing the preview first avoids leaving a latched grid pointing at a
        # just-deleted raster
        if self.previewing and self.previewing.get('site') == site \
                and self.previewing.get('raster') == raster:
            self._clear_preview()
        # belt-and-suspenders containment re-check right before rmtree
        real = os.path.realpath(rdir)
        if not real.startswith(os.path.realpath(self.base_dir) + os.sep):
            rospy.logwarn('mapping_manager: refusing to remove out-of-tree '
                          'raster %s', real)
            return
        try:
            shutil.rmtree(rdir)
        except OSError as e:
            self._serve_reject('remove_raster: delete failed for %s: %s'
                               % (payload, e))
            return
        self._raster_list_cache.pop(site, None)   # drop stale cached list
        rospy.logwarn('mapping_manager: removed raster %s/%s', site, raster)
        self.show_site(site)     # refresh disk previews (raster png may change)
        self.tick_status(None)   # push updated raster_list/status to the UI

    # ---- last-served persistence (bootfix2) ---------------------------------
    def _last_served_path(self):
        return os.path.join(self.base_dir, '.last_served')

    def save_last_served(self, site, raster):
        """Persist the currently-served site/raster so we can auto-serve it on
        the next boot (survives restarts / respawns)."""
        try:
            with open(self._last_served_path(), 'w') as f:
                json.dump({'site': site, 'raster': raster}, f)
        except Exception as e:
            rospy.logwarn('mapping_manager: could not persist last_served: %s', e)

    def load_last_served(self):
        """Return (site, raster) from the persisted state, or (None, None)."""
        try:
            with open(self._last_served_path()) as f:
                d = json.load(f)
            return d.get('site'), d.get('raster')
        except Exception:
            return None, None

    def auto_serve_last(self):
        """At boot, re-serve the last-served site (if it still has a raster) so
        /mapping_manager/site_map is latched immediately. Falls back to the newest
        site with any raster. No-op (logged) when nothing has a raster yet."""
        site, raster = self.load_last_served()
        # Validate the persisted raster still exists; otherwise refresh to newest.
        if site is not None:
            if raster is None or not os.path.exists(
                    os.path.join(self.base_dir, site, 'rasters', raster,
                                 raster + '.pgm')):
                raster = self._newest_raster_in(site)
        if site is None or raster is None:
            site = self._newest_site_with_raster()
            if site is not None:
                raster = self._newest_raster_in(site)
        if site is None or raster is None:
            rospy.loginfo('mapping_manager: auto_serve_last: no site has a '
                          'raster yet — site_map not served at boot')
            return
        rospy.loginfo('mapping_manager: auto-serving last site_map %s/%s at boot',
                      site, raster)
        self._publish_site_map(site, raster)

    def _publish_empty_site_map(self):
        """Publish an explicit EMPTY (header-only, 0x0) OccupancyGrid on
        /mapping_manager/site_map and clear all serving state. Used when a fresh
        site (no rasters) starts mapping: keeps serving CONSISTENT with the active
        session instead of leaving the previous site's raster latched.

        Downstream: gloc's cb_grid rejects grids with <20 occupied cells (0 here)
        -> tracker goes no_map/idle (correct while a fresh site is being mapped);
        navi_man's callback_site_map detects the empty/tiny grid and falls back to
        its truthful bootstrap map instead of the stale raster."""
        grid = OccupancyGrid()
        grid.header.stamp = rospy.Time.now()
        grid.header.frame_id = self.map_frame
        grid.info.resolution = 0.0
        grid.info.width = 0
        grid.info.height = 0
        grid.info.origin.orientation.w = 1.0
        grid.data = []
        self.pub_site_map.publish(grid)
        self.serving = None
        self.edits_applied = 0                # WP-D1: nothing served -> no edits
        self.pub_edit_list.publish(String(json.dumps([])))
        # Drop the persisted last-served so a respawn during the fresh session does
        # not re-latch the old raster at boot (auto_serve_last would otherwise pick
        # it up again). It gets rewritten when a real raster is next served.
        try:
            p = self._last_served_path()
            if os.path.exists(p):
                os.remove(p)
        except OSError as e:
            rospy.logwarn('mapping_manager: could not clear last_served: %s', e)
        rospy.loginfo('mapping_manager: site_map <- EMPTY (fresh session, '
                      'serving cleared)')

    def _publish_site_map(self, site, raster):
        base = os.path.join(self.base_dir, site, 'rasters', raster, raster)
        pgm_path = base + '.pgm'
        if not os.path.exists(pgm_path):
            rospy.logwarn('mapping_manager: serve_site: no such raster %s/%s',
                          site, raster)
            return
        data, resolution, origin_xy = load_occupancy_pgm(base)
        nx, ny = data.shape

        # WP-D1: composite human edits (edits.geojson, canonical UTM) onto the
        # pristine sensor raster before publishing. Sensor pgms on disk stay
        # untouched — regenerations never destroy human corrections. Failure
        # here must NEVER block serving: fall back to the raw raster.
        self.edits_applied = self._composite_edits(data, site, resolution,
                                                    origin_xy)

        grid = OccupancyGrid()
        grid.header.stamp = rospy.Time.now()
        grid.header.frame_id = self.map_frame
        grid.info.resolution = resolution
        grid.info.width = nx
        grid.info.height = ny
        grid.info.origin.position.x = origin_xy[0]
        grid.info.origin.position.y = origin_xy[1]
        grid.info.origin.orientation.w = 1.0
        grid.data = data.T.ravel().tolist()   # row-major over y rows,
                                               # matches band_projector
        self.pub_site_map.publish(grid)

        self.serving = {'site': site, 'raster': raster,
                        'mtime': int(os.path.getmtime(pgm_path))}
        self.serve_error = None   # a successful serve clears any prior rejection
        self.save_last_served(site, raster)
        # Keep the canonical site-datum symlink following the SERVED site, not
        # just the last MAPPED one (2026-07-11 review). Previously link_site_datum
        # ran only from start_proc (mapping), so serving site A's raster to gloc
        # while the link still pointed at a previously-mapped site B left
        # navi_transform's fallback datum offset from the served map (garden vs
        # garden2 datums differ ~0.23 m / 0.9 deg). Serving now relinks too.
        self.link_site_datum(site)
        # WP-D1: publish the edit list for the served site on every serve.
        self._publish_edit_list(site)
        rospy.loginfo('mapping_manager: site_map <- %s/%s (%dx%d @ %.3f m, '
                      '%d edits)', site, raster, nx, ny, resolution,
                      self.edits_applied)

    # ---- human map edits (WP-D1, SITE_BUNDLE_PLAN edits-mask) -----------------
    def _load_datum(self, site):
        """Return the canonical datum dict (geo schema) for <site>/datum.yaml,
        or None if the site has no (readable) datum. Edits are stored in UTM,
        so georeferencing them onto the map frame requires this datum."""
        path = os.path.join(self.base_dir, site, 'datum.yaml')
        try:
            with open(path) as f:
                d = yaml.safe_load(f)
            if not d or 'utm_e' not in d:
                return None
            return geo.from_datum_yaml(d)
        except (OSError, ValueError, KeyError, TypeError) as e:
            rospy.logwarn('mapping_manager: datum load failed for %s: %s',
                          site, e)
            return None

    def _composite_edits(self, data, site, resolution, origin_xy):
        """Composite <site>/edits.geojson (UTM) onto the int8 [ix,iy] raster
        array IN PLACE (last-writer-wins, list order). Returns the number of
        edits applied (0 when none / no datum / on any failure). NEVER raises —
        a compositing error must not block serving (raw raster is kept)."""
        try:
            edits = bundle.load_edits(site)
            if not edits:
                return 0
            datum = self._load_datum(site)
            if datum is None:
                rospy.logwarn('mapping_manager: %s has %d edits but no datum '
                              '— serving raw raster (edits not georeferenced)',
                              site, len(edits))
                return 0
            edits_map = editmask.edits_to_map(edits, datum)
            # composite on a copy so a mid-way failure still yields the raw map
            work = data.copy()
            applied = editmask.rasterize_edits(work, edits_map, resolution,
                                               origin_xy)
            data[...] = work
            return applied
        except Exception as e:
            rospy.logwarn('mapping_manager: edit compositing failed for %s: %s '
                          '— serving raw raster', site, e)
            return 0

    def _edit_records_map(self, site):
        """Return [{name, kind, width_m, points:[[x,y],...] MAP frame}] for the
        site's edits, converting canonical UTM back to the current map frame.
        [] if no edits or no datum (edits cannot be placed without a datum)."""
        edits = bundle.load_edits(site)
        if not edits:
            return []
        datum = self._load_datum(site)
        if datum is None:
            return []
        recs = []
        for e in edits:
            pts = [list(geo.utm_to_map(float(vx), float(vy), datum))
                   for (vx, vy) in e.get('vertices', [])]
            rec = {'name': e.get('name'), 'kind': e.get('kind'), 'points': pts}
            if e.get('kind') == 'wall':
                rec['width_m'] = float(e.get('width_m', 0.10))
            recs.append(rec)
        return recs

    def _publish_edit_list(self, site):
        """Publish the latched edit_list for the given site (MAP frame)."""
        try:
            recs = self._edit_records_map(site) if site else []
        except Exception as e:
            rospy.logwarn('mapping_manager: edit_list build failed for %s: %s',
                          site, e)
            recs = []
        self.pub_edit_list.publish(String(json.dumps(recs)))

    def _serving_site(self):
        return self.serving.get('site') if self.serving else None

    def _reserve_current(self):
        """Re-serve the current raster (re-composites edits + republishes
        site_map/edit_list). Used after an edit change."""
        if self.serving:
            self._publish_site_map(self.serving['site'],
                                   self.serving['raster'])

    def _next_edit_name(self, edits):
        """Autogenerate 'edit_<n>' not colliding with existing edit names."""
        n = 1
        existing = {e.get('name') for e in edits}
        while ('edit_%d' % n) in existing:
            n += 1
        return 'edit_%d' % n

    def cb_save_edit(self, msg):
        """Add/replace a human map edit on the SERVING site. Payload JSON:
        {name?, kind:'obstacle'|'free'|'wall', points:[[x,y],...] MAP frame,
        width_m? (wall, default 0.10)}. Converts map->UTM via the site datum,
        upserts by name into edits.geojson, then re-serves (composited)."""
        site = self._serving_site()
        if site is None:
            self._serve_reject('cannot save edit — no site is being served '
                               '(serve a map first)')
            return
        try:
            req = json.loads(msg.data)
        except (ValueError, TypeError) as e:
            self._serve_reject('save_edit: bad JSON: %s' % e)
            return
        kind = req.get('kind')
        if kind not in editmask.KIND_VALUE:
            self._serve_reject('save_edit: kind must be obstacle|free|wall '
                               '(got %r)' % kind)
            return
        pts = req.get('points') or []
        need = 1 if kind == 'wall' else 3
        if len(pts) < need:
            self._serve_reject('save_edit: %s needs >= %d points (got %d)'
                               % (kind, need, len(pts)))
            return
        datum = self._load_datum(site)
        if datum is None:
            self._serve_reject('cannot save edit — served site "%s" has no '
                               'datum.yaml (edits cannot be georeferenced)'
                               % site)
            return
        try:
            verts_utm = [geo.map_to_utm(float(p[0]), float(p[1]), datum)
                         for p in pts]
        except (ValueError, TypeError, IndexError) as e:
            self._serve_reject('save_edit: bad points: %s' % e)
            return
        edits = bundle.load_edits(site)
        name = (req.get('name') or '').strip() or self._next_edit_name(edits)
        rec = {'name': name, 'kind': kind, 'vertices': verts_utm}
        if kind == 'wall':
            rec['width_m'] = float(req.get('width_m', 0.10))
        # upsert by name, preserving order (replace in place, else append)
        replaced = False
        for i, e in enumerate(edits):
            if e.get('name') == name:
                edits[i] = rec
                replaced = True
                break
        if not replaced:
            edits.append(rec)
        try:
            bundle.save_edits(site, edits,
                              utm_zone=datum.get('utm_zone'))
        except Exception as e:
            self._serve_reject('save_edit: write failed: %s' % e)
            return
        rospy.loginfo('mapping_manager: %s edit %r (%s, %d pts) on %s',
                      'replaced' if replaced else 'added', name, kind,
                      len(pts), site)
        self._reserve_current()   # re-composite + republish site_map/edit_list

    def cb_remove_edit(self, msg):
        """Remove a human edit by name from the SERVING site; payload '*'
        clears ALL edits. Then re-serves (composited)."""
        site = self._serving_site()
        if site is None:
            self._serve_reject('cannot remove edit — no site is being served')
            return
        name = msg.data.strip()
        if not name:
            self._serve_reject('remove_edit: empty name')
            return
        if name == '*':
            p = bundle.edits_path(site)
            try:
                if os.path.exists(p):
                    os.remove(p)
                rospy.loginfo('mapping_manager: cleared ALL edits on %s', site)
            except OSError as e:
                self._serve_reject('remove_edit: clear failed: %s' % e)
                return
            self._reserve_current()
            return
        edits = bundle.load_edits(site)
        new = [e for e in edits if e.get('name') != name]
        if len(new) == len(edits):
            rospy.logwarn('mapping_manager: remove_edit: no edit named %r on '
                          '%s', name, site)
            self._publish_edit_list(site)   # UI resync anyway
            return
        try:
            if not new:
                p = bundle.edits_path(site)
                if os.path.exists(p):
                    os.remove(p)
            else:
                datum = self._load_datum(site)
                zone = datum.get('utm_zone') if datum else \
                    bundle.edits_utm_zone(site)
                bundle.save_edits(site, new, utm_zone=zone)
        except Exception as e:
            self._serve_reject('remove_edit: write failed: %s' % e)
            return
        rospy.loginfo('mapping_manager: removed edit %r from %s', name, site)
        self._reserve_current()

    # ---- status --------------------------------------------------------------
    def _raster_list(self, site, limit=12):
        """Up to `limit` newest rasters (by .pgm mtime) under <site>/rasters,
        each {name, mtime, cells_free, cells_obstacle}. cells come from the
        raster's <name>_meta.json when present (None when missing/unreadable).
        Cached per site keyed on the cheap (name, pgm-mtime) signature so the
        1 Hz status tick does not re-parse every meta.json (M12 dem_m2 pattern).
        """
        rasters = os.path.join(self.base_dir, site, 'rasters')
        if not os.path.isdir(rasters):
            return []
        entries = []
        for name in os.listdir(rasters):
            pgm = os.path.join(rasters, name, name + '.pgm')
            if not os.path.exists(pgm):
                continue
            entries.append((name, os.path.getmtime(pgm)))
        entries.sort(key=lambda e: e[1], reverse=True)
        entries = entries[:limit]
        sig = tuple(entries)
        cached = self._raster_list_cache.get(site)
        if cached is not None and cached[0] == sig:
            return cached[1]
        out = []
        for name, mtime in entries:
            rec = {'name': name, 'mtime': int(mtime),
                   'cells_free': None, 'cells_obstacle': None}
            meta = os.path.join(rasters, name, name + '_meta.json')
            try:
                with open(meta) as f:
                    m = json.load(f)
                rec['cells_free'] = m.get('cells_free')
                rec['cells_obstacle'] = m.get('cells_obstacle')
            except (OSError, ValueError):
                pass
            out.append(rec)
        self._raster_list_cache[site] = (sig, out)
        return out

    def site_info(self, name):
        d = os.path.join(self.base_dir, name)
        info = {'name': name, 'dem_kb': 0, 'rasters': 0, 'has_ot': False,
                'mtime': int(os.path.getmtime(d))}
        dem = os.path.join(d, 'dem.npz')
        if os.path.exists(dem):
            info['dem_kb'] = os.path.getsize(dem) // 1024
            # M12: dem_m2 needs decompressing the npz — cache it per site keyed
            # on mtime so the 1 Hz status tick doesn't reload every dem.npz.
            mtime = os.path.getmtime(dem)
            cached = self._dem_m2_cache.get(name)
            if cached is not None and cached[0] == mtime:
                info['dem_m2'] = cached[1]
            else:
                try:
                    with np.load(dem) as f:
                        src = f['source']
                        res = float(f['res'])
                        m2 = round(int((src != 0).sum()) * res * res, 1)
                    info['dem_m2'] = m2
                    self._dem_m2_cache[name] = (mtime, m2)
                except Exception:
                    pass
        rasters = os.path.join(d, 'rasters')
        if os.path.isdir(rasters):
            info['rasters'] = len(os.listdir(rasters))
        info['has_ot'] = any(f.endswith('.ot') for f in os.listdir(d))
        # per-raster mgmt: up to 12 newest rasters w/ cell counts (cached).
        info['raster_list'] = self._raster_list(name)
        return info

    def tick_status(self, _evt):
        if self.proc is not None and self.proc.poll() is not None:
            rospy.logwarn('mapping_manager: launch exited (code %s)',
                          self.proc.returncode)
            self.proc = None
            self.site = None
            self.started_at = None
            self.session_resolution = None    # M13
            self.session_octomap = None       # M14
        sites = sorted(n for n in os.listdir(self.base_dir)
                       if os.path.isdir(os.path.join(self.base_dir, n)))
        status = {
            'running': self.running(),
            'site': self.site,
            'uptime_s': int(time.time() - self.started_at)
                        if self.started_at else 0,
            'pid': self.proc.pid if self.running() else None,
            'sites': [self.site_info(n) for n in sites],
            'serving': self.serving,
            'previewing': self.previewing,            # per-raster mgmt
            'serve_error': self.serve_error,
            'resolution': self.session_resolution,   # M13
            'octomap': self.session_octomap,          # M14 (nooctomap)
            'datum_warning': self.datum_warning,      # M9
            'edits_applied': self.edits_applied,      # WP-D1
        }
        self.pub_status.publish(String(json.dumps(status)))


