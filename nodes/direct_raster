def _clamp(v, lo, hi):
    return max(lo, min(hi, v))


def _cluster_filter_xy(x, y, radius, min_pts):
    """Keep-mask for points whose connected blob (grid cells of size `radius`,
    8-neighborhood) holds >= min_pts points. Approximates radius clustering
    without scipy; clouds here are voxel-thinned (<= a few thousand points)."""
    n = x.size
    if min_pts <= 1 or n == 0:
        return np.ones(n, dtype=bool)
    cell = max(float(radius), 1e-3)
    ix = np.floor(x / cell).astype(np.int64)
    iy = np.floor(y / cell).astype(np.int64)
    cells = {}
    for i in range(n):
        cells.setdefault((ix[i], iy[i]), []).append(i)
    keep = np.zeros(n, dtype=bool)
    seen = set()
    for start in cells:
        if start in seen:
            continue
        seen.add(start)
        stack = [start]
        comp = []
        while stack:
            cx, cy = stack.pop()
            comp.append((cx, cy))
            for dx in (-1, 0, 1):
                for dy in (-1, 0, 1):
                    nb = (cx + dx, cy + dy)
                    if nb in cells and nb not in seen:
                        seen.add(nb)
                        stack.append(nb)
        if sum(len(cells[c]) for c in comp) >= min_pts:
            for c in comp:
                keep[cells[c]] = True
    return keep


