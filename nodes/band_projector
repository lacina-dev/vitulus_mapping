#!/usr/bin/env python3
"""band_projector — regenerates the ground-relative 2D obstacle raster on
demand (Mapping v3, phase 2): obstacle(x, y) = occupied-voxel evidence with
z - DEM(x, y) in [0.10, 0.60] m above LOCAL ground.

Pipeline per regeneration (all on a COPY of the canonical DEM):
  1. ask trajectory_dem to save, then load dem.npz
  2. percentile fill of DEM from octomap occupied columns (undriven areas)
  3. slope-consistency filter of fills + bounded inpainting
  4. band classification -> raster; publish + export map_server pgm/yaml

EVIDENCE SOURCE (audit 2026-07-12, finding #4). This node's obstacle evidence
comes from octomap_point_cloud_centers = ALL occupied voxels, ground included:
insertion_gate merges /ground_cloud + /obstacles_cloud into one octomap, so the
ground-vs-obstacle split that EXISTS at the source is already destroyed before
we see it. Reconstructing an obstacle-only stream consumer-side is therefore
NOT clean. The clean consumer-side ground-peel we CAN do is done here: band
evidence is anchored only on REAL ground (trajectory/percentile-fill, never
inpaint-invented ground; see band.project_band) and min_evidence=6, which
suppresses near-ground z-noise leak without a blunt band_min raise (measured:
band_min 0.10 vs 0.12 identical on garden.ot after real-ground anchoring).
NOTE FOR insertion_gate OWNER: a truly obstacle-pure archive would require a
source-side change — insert /obstacles_cloud into a SEPARATE octomap (or tag
voxels by source cloud) so band evidence can consume obstacle voxels only. That
is out of this tier's scope and left to the insertion_gate/octomap owner.

Interfaces (relative to /mapping):
  in   octomap_point_cloud_centers  sensor_msgs/PointCloud2 (from octomap_server)
  trig regenerate          std_msgs/String ('' or raster name)
  trig set_band            std_msgs/String JSON {band_min?, band_max?,
                           min_evidence?, min_cluster_cells?} — live classifier
                           tuning; validated, persisted per-site, auto-regen
  trig regenerate_srv      std_srvs/Trigger (returns stats JSON)
  trig save                std_msgs/String — full snapshot: garden.ot (via
                           octomap_saver) + dem.npz + fresh raster
  trig compare             std_msgs/String — A/B stats vs /rtabmap/grid_map
  out  obstacle_map        nav_msgs/OccupancyGrid (latched)
  out  projector_status    std_msgs/String (latched JSON)
"""

import json
import os
import subprocess
import tempfile
import threading
import time

import numpy as np
import rospy
from nav_msgs.msg import OccupancyGrid
from sensor_msgs.msg import CompressedImage, PointCloud2
from std_msgs.msg import String
from std_srvs.srv import Empty, Trigger, TriggerResponse

from vitulus_mapping.band import compare_rasters, project_band
from vitulus_mapping.demgrid import DemGrid
from vitulus_mapping.pgmio import save_occupancy_pgm
from vitulus_mapping.preview import raster_to_png
from vitulus_mapping.roscloud import pointcloud2_to_xyz


class BandProjectorNode:
    def __init__(self):
        self.map_frame = rospy.get_param('~map_frame', 'map')
        self.band_min = float(rospy.get_param('~band_min', 0.10))
        self.band_max = float(rospy.get_param('~band_max', 0.60))
        self.min_evidence = int(rospy.get_param('~min_evidence', 6))
        self.min_cluster_cells = int(rospy.get_param('~min_cluster_cells', 3))
        # ISSUE A fix (lidarsync 2026-07-12): reference lidar-only vertical
        # obstacles in undriven columns against the nearest real ground within
        # this radius (see band.project_band). 0 = strict same-column only.
        self.ground_ref_radius_m = float(
            rospy.get_param('~ground_ref_radius_m', 1.0))
        # ISSUE A part 2: lower per-cell evidence floor for borrowed-ground
        # (2D-lidar-only) cells; the thin lidar plane gives ~1-2 voxels/cell.
        self.borrowed_min_evidence = int(
            rospy.get_param('~borrowed_min_evidence', 2))
        # REPORT 1 (freeserve 2026-07-12): extend the ground-borrow to FREE, so
        # driveable surroundings of the driven ribbon are FREE, not UNKNOWN,
        # after the DEM tightening. free_ground_radius_m defaults to
        # ground_ref_radius_m (kept in sync unless overridden separately).
        self.free_via_borrowed_ground = bool(
            rospy.get_param('~free_via_borrowed_ground', True))
        self.free_ground_radius_m = float(
            rospy.get_param('~free_ground_radius_m', self.ground_ref_radius_m))
        # --- classifier v2 (2026-07-19) -------------------------------------
        # D1: FREE = real ground + octomap-free-band mask (see band.project_band).
        # The old occlusion-blind borrow-ring FREE is retired to the default
        # path but kept behind free_borrow_legacy for rollback.
        self.free_borrow_legacy = bool(
            rospy.get_param('~free_borrow_legacy', False))
        # octomap free voxel accepted as FREE if z-ground in this band (m). The
        # lower bound is negative: raytraced free space also sits at/just below
        # local ground level.
        self.free_band_min = float(rospy.get_param('~free_band_min', -0.30))
        self.free_band_max = float(rospy.get_param('~free_band_max', 0.60))
        # D2: cluster z-top gate. A surviving obstacle cluster is dropped iff it
        # is small AND low (max column z-top above ground) AND far from any
        # driven trajectory cell — isolates false lawn patches from thin real
        # 2D-lidar walls.
        self.cluster_min_size = int(rospy.get_param('~cluster_min_size', 15))
        self.cluster_min_ztop_m = float(
            rospy.get_param('~cluster_min_ztop_m', 0.30))
        self.cluster_traj_dist_m = float(
            rospy.get_param('~cluster_traj_dist_m', 0.6))
        # D3: the ot_dump helper reads octomap FREE leaves off the saved
        # garden.ot (octomap_server publishes only OCCUPIED centres on the wire).
        self.ot_dump_timeout_s = float(
            rospy.get_param('~ot_dump_timeout_s', 60.0))
        self.fill_percentile = float(rospy.get_param('~fill_percentile', 1.5))
        self.fill_min_pts = int(rospy.get_param('~fill_min_pts', 6))
        self.max_slope_deg = float(rospy.get_param('~max_slope_deg', 35.0))
        self.inpaint_max_dist_m = float(rospy.get_param('~inpaint_max_dist_m', 0.15))
        self.output_dir = os.path.expanduser(rospy.get_param(
            '~output_dir', '~/.vitulus/mapping_v3/default'))
        self.dem_path = os.path.join(self.output_dir, 'dem.npz')
        # M5: how long load_dem waits for trajectory_dem's save to land
        # (mtime advance) before giving up and loading whatever exists.
        self.dem_save_wait_s = float(rospy.get_param('~dem_save_wait_s', 15.0))
        self.overrides_path = os.path.join(self.output_dir,
                                           'band_overrides.json')
        # per-site classifier overrides persist across sessions for this site
        self.load_band_overrides()

        self.centers_msg = None
        self.last_raster = None      # (raster, dem_copy) for compare
        self.busy = threading.Lock()

        self.pub_map = rospy.Publisher('obstacle_map', OccupancyGrid,
                                       queue_size=1, latch=True)
        self.pub_png = rospy.Publisher('obstacle_map_png', CompressedImage,
                                       queue_size=1, latch=True)
        self.pub_status = rospy.Publisher('projector_status', String,
                                          queue_size=1, latch=True)
        self.pub_save_dem = rospy.Publisher('save_dem', String, queue_size=1)
        self.last_state = {'state': 'idle'}

        rospy.Subscriber('octomap_point_cloud_centers', PointCloud2,
                         self.cb_centers, queue_size=1, buff_size=2 ** 26)
        rospy.Subscriber('regenerate', String, self.cb_regenerate, queue_size=1)
        rospy.Subscriber('set_band', String, self.cb_set_band, queue_size=1)
        rospy.Subscriber('save', String, self.cb_save, queue_size=1)
        rospy.Subscriber('compare', String, self.cb_compare, queue_size=1)
        rospy.Subscriber('clear', String, self.cb_clear, queue_size=1)
        rospy.Service('regenerate_srv', Trigger, self.srv_regenerate)
        rospy.Timer(rospy.Duration(2.0), self.tick_status)
        auto_s = float(rospy.get_param('~auto_regen_period_s', 10.0))
        if auto_s > 0:
            rospy.Timer(rospy.Duration(auto_s), self.tick_auto_regen)
        self.status('idle')
        rospy.loginfo('band_projector up: band=[%.2f, %.2f] out=%s',
                      self.band_min, self.band_max, self.output_dir)

    def status(self, state, extra=None):
        d = {'state': state}
        if extra:
            d.update(extra)
        self.last_state = d
        self.tick_status(None)

    def tick_status(self, _evt):
        d = dict(self.last_state)
        c = self.centers_msg
        d['octomap_points'] = c.width * c.height if c is not None else 0
        # always advertise the live classifier settings so the UI can prefill
        # its controls and show the currently-applied values
        d['band_min'] = round(self.band_min, 3)
        d['band_max'] = round(self.band_max, 3)
        d['min_evidence'] = self.min_evidence
        d['min_cluster_cells'] = self.min_cluster_cells
        d['ground_ref_radius_m'] = round(self.ground_ref_radius_m, 2)
        d['borrowed_min_evidence'] = self.borrowed_min_evidence
        d['free_via_borrowed_ground'] = self.free_via_borrowed_ground
        d['free_ground_radius_m'] = round(self.free_ground_radius_m, 2)
        d['free_borrow_legacy'] = self.free_borrow_legacy
        d['free_band_min'] = round(self.free_band_min, 2)
        d['free_band_max'] = round(self.free_band_max, 2)
        d['cluster_min_size'] = self.cluster_min_size
        d['cluster_min_ztop_m'] = round(self.cluster_min_ztop_m, 2)
        d['cluster_traj_dist_m'] = round(self.cluster_traj_dist_m, 2)
        self.pub_status.publish(String(json.dumps(d)))

    # ---- classifier settings (live tuning) ----------------------------------
    def load_band_overrides(self):
        """Load per-site classifier overrides saved by a previous session for
        this site, so the obstacle band the user tuned survives restarts."""
        try:
            if not os.path.exists(self.overrides_path):
                return
            with open(self.overrides_path) as f:
                ov = json.load(f)
            ok, _err = self.apply_band_settings(ov, persist=False,
                                                 regen=False, log=False)
            if ok:
                rospy.loginfo('band_projector: loaded per-site band overrides '
                              '%s from %s', json.dumps(ok), self.overrides_path)
        except Exception as e:
            rospy.logwarn('band_projector: could not load band overrides: %s', e)

    def save_band_overrides(self):
        try:
            os.makedirs(self.output_dir, exist_ok=True)
            with open(self.overrides_path, 'w') as f:
                json.dump({'band_min': self.band_min,
                           'band_max': self.band_max,
                           'min_evidence': self.min_evidence,
                           'min_cluster_cells': self.min_cluster_cells,
                           'ground_ref_radius_m': self.ground_ref_radius_m,
                           'borrowed_min_evidence': self.borrowed_min_evidence,
                           'free_via_borrowed_ground':
                               self.free_via_borrowed_ground,
                           'free_ground_radius_m': self.free_ground_radius_m,
                           'free_borrow_legacy': self.free_borrow_legacy,
                           'free_band_min': self.free_band_min,
                           'free_band_max': self.free_band_max,
                           'cluster_min_size': self.cluster_min_size,
                           'cluster_min_ztop_m': self.cluster_min_ztop_m,
                           'cluster_traj_dist_m': self.cluster_traj_dist_m},
                          f, indent=1)
        except Exception as e:
            rospy.logwarn('band_projector: could not save band overrides: %s', e)

    def apply_band_settings(self, req, persist=True, regen=True, log=True):
        """Validate + apply a partial {band_min, band_max, min_evidence,
        min_cluster_cells} dict. Returns (applied_dict|None, error|None).
        Ranges: 0<=band_min<band_max<=2.0; evidence/cluster in 1..20."""
        try:
            band_min = float(req.get('band_min', self.band_min))
            band_max = float(req.get('band_max', self.band_max))
            min_evidence = int(req.get('min_evidence', self.min_evidence))
            min_cluster = int(req.get('min_cluster_cells',
                                      self.min_cluster_cells))
            ground_ref = float(req.get('ground_ref_radius_m',
                                       self.ground_ref_radius_m))
            borrowed_ev = int(req.get('borrowed_min_evidence',
                                      self.borrowed_min_evidence))
            free_borrow = bool(req.get('free_via_borrowed_ground',
                                       self.free_via_borrowed_ground))
            free_radius = float(req.get('free_ground_radius_m',
                                        self.free_ground_radius_m))
            free_legacy = bool(req.get('free_borrow_legacy',
                                       self.free_borrow_legacy))
            free_bmin = float(req.get('free_band_min', self.free_band_min))
            free_bmax = float(req.get('free_band_max', self.free_band_max))
            cl_size = int(req.get('cluster_min_size', self.cluster_min_size))
            cl_ztop = float(req.get('cluster_min_ztop_m',
                                    self.cluster_min_ztop_m))
            cl_tdist = float(req.get('cluster_traj_dist_m',
                                     self.cluster_traj_dist_m))
        except (TypeError, ValueError) as e:
            return None, 'non-numeric value: %s' % e
        if not (0.0 <= band_min < band_max <= 2.0):
            return None, ('band out of range (need 0<=min<max<=2.0), got '
                          '[%s, %s]' % (band_min, band_max))
        if not (1 <= min_evidence <= 20):
            return None, 'min_evidence out of range 1..20: %s' % min_evidence
        if not (1 <= min_cluster <= 20):
            return None, ('min_cluster_cells out of range 1..20: %s'
                          % min_cluster)
        if not (0.0 <= ground_ref <= 5.0):
            return None, ('ground_ref_radius_m out of range 0..5: %s'
                          % ground_ref)
        if not (1 <= borrowed_ev <= 20):
            return None, ('borrowed_min_evidence out of range 1..20: %s'
                          % borrowed_ev)
        if not (0.0 <= free_radius <= 5.0):
            return None, ('free_ground_radius_m out of range 0..5: %s'
                          % free_radius)
        if not (-2.0 <= free_bmin < free_bmax <= 2.0):
            return None, ('free_band out of range (need -2<=min<max<=2), got '
                          '[%s, %s]' % (free_bmin, free_bmax))
        if not (1 <= cl_size <= 500):
            return None, ('cluster_min_size out of range 1..500: %s' % cl_size)
        if not (0.0 <= cl_ztop <= 5.0):
            return None, ('cluster_min_ztop_m out of range 0..5: %s' % cl_ztop)
        if not (0.0 <= cl_tdist <= 20.0):
            return None, ('cluster_traj_dist_m out of range 0..20: %s'
                          % cl_tdist)
        self.band_min = band_min
        self.band_max = band_max
        self.min_evidence = min_evidence
        self.min_cluster_cells = min_cluster
        self.ground_ref_radius_m = ground_ref
        self.borrowed_min_evidence = borrowed_ev
        self.free_via_borrowed_ground = free_borrow
        self.free_ground_radius_m = free_radius
        self.free_borrow_legacy = free_legacy
        self.free_band_min = free_bmin
        self.free_band_max = free_bmax
        self.cluster_min_size = cl_size
        self.cluster_min_ztop_m = cl_ztop
        self.cluster_traj_dist_m = cl_tdist
        applied = {'band_min': band_min, 'band_max': band_max,
                   'min_evidence': min_evidence,
                   'min_cluster_cells': min_cluster,
                   'ground_ref_radius_m': ground_ref,
                   'borrowed_min_evidence': borrowed_ev,
                   'free_via_borrowed_ground': free_borrow,
                   'free_ground_radius_m': free_radius,
                   'free_borrow_legacy': free_legacy,
                   'free_band_min': free_bmin, 'free_band_max': free_bmax,
                   'cluster_min_size': cl_size,
                   'cluster_min_ztop_m': cl_ztop,
                   'cluster_traj_dist_m': cl_tdist}
        if log:
            rospy.loginfo('band_projector: classifier settings -> %s',
                          json.dumps(applied))
        if persist:
            self.save_band_overrides()
        if regen:
            # re-raster (in-memory, no disk snapshot) so the effect is
            # immediately visible in the UI live grid
            threading.Thread(target=self.regenerate,
                             kwargs={'write_files': False},
                             daemon=True).start()
        return applied, None

    def cb_set_band(self, msg):
        try:
            req = json.loads(msg.data) if msg.data.strip() else {}
        except ValueError as e:
            rospy.logwarn('band_projector: set_band bad JSON: %s', e)
            self.status('error', {'error': 'set_band bad JSON: %s' % e})
            return
        if not isinstance(req, dict):
            rospy.logwarn('band_projector: set_band payload not an object')
            return
        applied, err = self.apply_band_settings(req)
        if err:
            rospy.logwarn('band_projector: set_band rejected: %s', err)
            self.status('error', {'error': 'set_band: ' + err})
        else:
            # refresh the latched status so the UI reflects the new values now
            self.tick_status(None)

    def cb_centers(self, msg):
        self.centers_msg = msg

    # ---- triggers -----------------------------------------------------------
    def cb_regenerate(self, msg):
        threading.Thread(target=self.regenerate,
                         args=(msg.data.strip() or None,), daemon=True).start()

    def srv_regenerate(self, _req):
        info = self.regenerate(None)
        return TriggerResponse(success=info is not None,
                               message=json.dumps(info or {}))

    def cb_save(self, msg):
        # M10: payload is either a plain raster name (legacy) or a JSON object
        # {name?, write_ot?}. raster_on_stop sends write_ot=False so it does NOT
        # mint an extra final_<ts>.ot (mapping_manager writes garden.ot itself),
        # which otherwise orphaned one .ot per Stop.
        payload = msg.data.strip()
        name, write_ot = (payload or None), True
        if payload.startswith('{'):
            try:
                req = json.loads(payload)
                name = req.get('name') or None
                write_ot = bool(req.get('write_ot', True))
            except ValueError as e:
                rospy.logwarn('band_projector: save bad JSON: %s', e)
                return
        threading.Thread(target=self.full_save,
                         args=(name, write_ot), daemon=True).start()

    def cb_compare(self, msg):
        threading.Thread(target=self.compare, daemon=True).start()

    def cb_clear(self, _msg):
        """Reset the 3D evidence archive (after a localization correction
        shifted previously inserted data). The DEM is kept — its running
        mean re-converges; obstacles re-accumulate within seconds."""
        def run():
            try:
                rospy.ServiceProxy('octomap_server/reset', Empty)()
                self.centers_msg = None
                rospy.logwarn('band_projector: octomap CLEARED on request')
                self.status('cleared')
                self.regenerate(write_files=False)
            except Exception as e:
                rospy.logerr('band_projector: clear failed: %s', e)
                self.status('error', {'error': str(e)})
        threading.Thread(target=run, daemon=True).start()

    def tick_auto_regen(self, _evt):
        """Live raster: regenerate periodically while data flows so the UI
        3D view shows ground vs obstacles as mapping progresses. No disk
        writes — snapshots stay manual."""
        if self.centers_msg is None or self.busy.locked():
            return
        threading.Thread(target=self.regenerate,
                         kwargs={'write_files': False}, daemon=True).start()

    # ---- core ---------------------------------------------------------------
    def load_dem(self):
        """Ask the DEM node for a fresh save, then load it once the file is
        actually rewritten. M5: the old fixed 2 s sleep raced ahead of a big
        DEM's save (trajectory_dem snapshots + compresses a hectare) and read a
        STALE dem.npz. Poll the mtime (0.2 s) until it advances past what it was
        before the save request, or dem_save_wait_s elapses (then load whatever
        exists). trajectory_dem writes atomically via os.replace, so the mtime
        jump is a reliable 'new file landed' signal."""
        try:
            mtime0 = os.path.getmtime(self.dem_path)
        except OSError:
            mtime0 = 0.0
        self.pub_save_dem.publish(String(''))
        deadline = time.monotonic() + self.dem_save_wait_s
        while time.monotonic() < deadline:
            try:
                if os.path.getmtime(self.dem_path) > mtime0:
                    break
            except OSError:
                pass
            time.sleep(0.2)
        else:
            rospy.logwarn('band_projector: DEM save not observed within %.1fs '
                          '— loading existing dem.npz', self.dem_save_wait_s)
        if not os.path.exists(self.dem_path):
            rospy.logerr('band_projector: no DEM at %s', self.dem_path)
            return None
        return DemGrid.load_npz(self.dem_path)

    def load_free_leaves(self, occupied_count=0):
        """D3 (classifier v2): dump the saved garden.ot with the ot_dump helper
        and return its octomap FREE leaf centres as an (N, 3) float64 array in
        the map frame — the raytraced free space that feeds band's FREE mask.

        Returns None (=> treat as zero free leaves) when: garden.ot is not on
        disk, the ot_dump helper is missing/not built, it times out, or the file
        is empty. In every failure case the caller falls back to real-ground-only
        FREE (or the legacy borrow rings if free_borrow_legacy is enabled).

        occupied_count: live occupied-centre count, only used to logwarn loudly
        when free leaves look suspiciously sparse (a session built without
        raytracing would otherwise yield a mostly-unknown map)."""
        ot_path = os.path.join(self.output_dir, 'garden.ot')
        if not os.path.exists(ot_path):
            rospy.logwarn('band_projector: no garden.ot at %s — FREE from '
                          'real ground only (no octomap free mask)', ot_path)
            return None
        fd, tmp = tempfile.mkstemp(suffix='.bin', prefix='ot_free_')
        os.close(fd)
        try:
            cmd = ['rosrun', 'vitulus_mapping', 'ot_dump', ot_path, tmp]
            subprocess.run(cmd, check=True, timeout=self.ot_dump_timeout_s,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            raw = np.fromfile(tmp, dtype=np.float32)
            if raw.size == 0 or raw.size % 5:
                rospy.logwarn('band_projector: ot_dump produced no/garbled '
                              'leaves — FREE from real ground only')
                return None
            leaves = raw.reshape(-1, 5)
            is_free = leaves[:, 4] < 0.5
            n_free = int(is_free.sum())
            n_occ = int((~is_free).sum())
            ref = n_occ or occupied_count
            if ref and n_free < 0.10 * ref:
                rospy.logwarn('band_projector: SUSPICIOUSLY FEW octomap free '
                              'leaves (%d free vs %d occupied, <10%%) — was this '
                              'session built WITHOUT raytracing? FREE will be '
                              'mostly real-ground-only/unknown.', n_free, n_occ)
            else:
                rospy.loginfo('band_projector: ot_dump %d free / %d occupied '
                              'leaves from garden.ot', n_free, n_occ)
            return leaves[is_free, :3].astype(np.float64)
        except FileNotFoundError:
            rospy.logwarn('band_projector: ot_dump helper not found (rosrun) — '
                          'build it (catkin_make --pkg vitulus_mapping); FREE '
                          'from real ground only')
            return None
        except subprocess.TimeoutExpired:
            rospy.logwarn('band_projector: ot_dump timed out (%.0fs) — FREE '
                          'from real ground only', self.ot_dump_timeout_s)
            return None
        except Exception as e:
            rospy.logwarn('band_projector: ot_dump failed (%s) — FREE from '
                          'real ground only', e)
            return None
        finally:
            try:
                os.remove(tmp)
            except OSError:
                pass

    def regenerate(self, name=None, write_files=True):
        # File-writing regenerations (manual save / regenerate) must not lose
        # the lock race against the periodic auto-regen timer — wait for it,
        # otherwise the raster is silently skipped. Live (write_files=False)
        # auto-regens still bail immediately if one is already running.
        if write_files:
            if not self.busy.acquire(blocking=True, timeout=60.0):
                rospy.logwarn('band_projector: regeneration busy >60s, skipped')
                return None
        elif not self.busy.acquire(blocking=False):
            return None
        try:
            t0 = time.monotonic()
            if write_files:
                self.status('regenerating')
            dem = self.load_dem()
            if dem is None:
                if write_files:
                    self.status('error', {'error': 'no DEM'})
                return None
            centers = self.centers_msg
            pts = (pointcloud2_to_xyz(centers)
                   if centers is not None else np.empty((0, 3), np.float32))
            if centers is None:
                rospy.logwarn('band_projector: no octomap centers yet — '
                              'raster from DEM only')

            work = dem.copy()
            filled = work.fill_from_columns(pts, self.fill_percentile,
                                            self.fill_min_pts)
            dropped = work.slope_filter_fills(self.max_slope_deg)
            inpainted = work.inpaint(self.inpaint_max_dist_m)
            # v2 D1/D3: octomap FREE leaves off the saved garden.ot (raytraced
            # free space). None => real-ground-only FREE (legacy rings honoured
            # only if free_borrow_legacy is set). Skipped in legacy mode.
            free_xyz = (None if self.free_borrow_legacy
                        else self.load_free_leaves(occupied_count=len(pts)))
            raster, info = project_band(work, pts, self.band_min,
                                        self.band_max, self.min_evidence,
                                        self.min_cluster_cells,
                                        self.ground_ref_radius_m,
                                        self.borrowed_min_evidence,
                                        self.free_via_borrowed_ground,
                                        self.free_ground_radius_m,
                                        free_xyz=free_xyz,
                                        free_band_min=self.free_band_min,
                                        free_band_max=self.free_band_max,
                                        free_borrow_legacy=self.free_borrow_legacy,
                                        cluster_min_size=self.cluster_min_size,
                                        cluster_min_ztop_m=self.cluster_min_ztop_m,
                                        cluster_traj_dist_m=self.cluster_traj_dist_m)
            info.update({'fill_cells': filled, 'fill_dropped_slope': dropped,
                         'inpainted_cells': inpainted, 'points': len(pts),
                         'took_s': round(time.monotonic() - t0, 1)})

            stamp = rospy.Time.now()
            self.publish_grid(raster, work, stamp)
            self.publish_png(raster, stamp)
            self.last_raster = (raster, work)

            if write_files:
                out_name = name or time.strftime('rastr_%Y%m%d_%H%M%S')
                base = os.path.join(self.output_dir, 'rasters', out_name,
                                    out_name)
                save_occupancy_pgm(base, raster, work.res, (work.ox, work.oy))
                with open(base + '_meta.json', 'w') as f:
                    json.dump(info, f, indent=1)
                rospy.loginfo('band_projector: %s -> %s',
                              json.dumps(info), base)
                self.status('done', info)
            else:
                self.status('live', info)
            return info
        except Exception as e:
            rospy.logerr('band_projector: regeneration failed: %s', e)
            self.status('error', {'error': str(e)})
            return None
        finally:
            self.busy.release()

    def publish_grid(self, raster, dem, stamp):
        nx, ny = raster.shape
        msg = OccupancyGrid()
        msg.header.stamp = stamp
        msg.header.frame_id = self.map_frame
        msg.info.resolution = dem.res
        msg.info.width = nx
        msg.info.height = ny
        msg.info.origin.position.x = dem.ox
        msg.info.origin.position.y = dem.oy
        msg.info.origin.orientation.w = 1.0
        msg.data = raster.T.ravel().tolist()   # row-major over y rows
        self.pub_map.publish(msg)

    def publish_png(self, raster, stamp):
        try:
            png, _ = raster_to_png(raster)
        except Exception as e:
            rospy.logwarn('band_projector: png failed: %s', e)
            return
        img = CompressedImage()
        img.header.stamp = stamp
        img.format = 'png'
        img.data = png
        self.pub_png.publish(img)

    def full_save(self, name=None, write_ot=True):
        """Snapshot: .ot archive (optional) + DEM + fresh raster into
        output_dir. M10: write_ot=False skips minting a final_<ts>.ot — used by
        raster_on_stop, where mapping_manager saves garden.ot separately, so the
        per-Stop .ot was just orphaned cruft."""
        if write_ot:
            ot_path = os.path.join(self.output_dir,
                                   (name or 'garden') + '.ot')
            os.makedirs(self.output_dir, exist_ok=True)
            ns = rospy.get_namespace().rstrip('/') or '/mapping'
            cmd = ['rosrun', 'octomap_server', 'octomap_saver', '-f', ot_path,
                   '__ns:=' + ns]
            try:
                subprocess.run(cmd, check=True, timeout=120,
                               stdout=subprocess.DEVNULL,
                               stderr=subprocess.STDOUT)
                rospy.loginfo('band_projector: octomap saved %s', ot_path)
            except Exception as e:
                rospy.logerr('band_projector: octomap_saver failed: %s', e)
        self.regenerate(name)

    def compare(self):
        """A/B vs the current rtabmap occupancy grid, resampled onto ours."""
        if self.last_raster is None:
            rospy.logwarn('band_projector: regenerate first, then compare')
            return
        try:
            ref = rospy.wait_for_message('/rtabmap/grid_map', OccupancyGrid,
                                         timeout=5.0)
        except rospy.ROSException:
            rospy.logwarn('band_projector: /rtabmap/grid_map unavailable')
            return
        raster, dem = self.last_raster
        nx, ny = raster.shape
        xs = dem.ox + (np.arange(nx) + 0.5) * dem.res
        ys = dem.oy + (np.arange(ny) + 0.5) * dem.res
        gx, gy = np.meshgrid(xs, ys, indexing='ij')
        rx = np.floor((gx - ref.info.origin.position.x)
                      / ref.info.resolution).astype(np.int64)
        ry = np.floor((gy - ref.info.origin.position.y)
                      / ref.info.resolution).astype(np.int64)
        ref_arr = np.array(ref.data, np.int8).reshape(ref.info.height,
                                                      ref.info.width)
        b = np.full((nx, ny), -1, np.int8)
        ok = (rx >= 0) & (rx < ref.info.width) & (ry >= 0) & (ry < ref.info.height)
        b[ok] = ref_arr[ry[ok], rx[ok]]
        b[b >= 65] = 100
        b[(b >= 0) & (b < 65)] = 0
        stats = compare_rasters(raster, b)
        path = os.path.join(self.output_dir,
                            time.strftime('compare_%Y%m%d_%H%M%S.json'))
        with open(path, 'w') as f:
            json.dump(stats, f, indent=1)
        rospy.loginfo('band_projector: A/B vs rtabmap: %s -> %s',
                      json.dumps(stats), path)
        self.status('compared', stats)


