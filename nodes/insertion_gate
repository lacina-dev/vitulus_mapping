#!/usr/bin/env python3
"""insertion_gate — gated insertion for mapping with known poses (Mapping v3,
phase 0). Passes sensor clouds to octomap ONLY when the pose is trustworthy
(RTK FIXED + accuracy + heading agreement + innovation gates); logs every
decision. Runs alongside the existing stack, publishes nothing outside
/mapping/*.

Because the nav EKF does not estimate z (map-frame TF z stays ~0), passed
clouds are re-parented to an alias TF frame ('<orig>_mapping') whose transform
equals TF map->sensor with z corrected from navsat /odometry/gps altitude.
octomap_server then raytraces from the true sensor origin and voxels get real
absolute z, consistent with the trajectory DEM.

Interfaces (all names relative to the node's namespace, /mapping by default):
  in   ~cloud_topics        (default /ground_cloud, /obstacles_cloud)
  in   /gnss/navpvt         ublox_msgs/NavPVT (RTK carrier solution, hAcc/vAcc)
  in   /gnss_heading/nav_fused  sensor_msgs/Imu (dual-antenna heading)
  in   /odometry/gps        nav_msgs/Odometry (navsat map-frame pose + altitude)
  out  cloud_in             sensor_msgs/PointCloud2 (gated, alias frame)
  out  gate                 std_msgs/Bool  (5 Hz, current decision)
  out  gate_status          std_msgs/String (1 Hz latched JSON)
  set  gate_mode            std_msgs/String ('rtk' | 'force_on' | 'off')
  log  <output_dir>/logs/gate_YYYYmmdd_HHMMSS.csv (one row per cloud)

Georef capture (POSE_DATUM_PLAN.md phase 1a, additive): once per session,
after ~5 s of sustained RTK-grade quality, the UTM pose of the SITE (map)
frame origin is computed from TF (utm->odom o inv(map->odom)) and stored to
<output_dir>/datum.yaml (first time) + datum_session_*.yaml (every session,
for drift tracking). Nothing consumes it yet — it is the foundation for
persistent site georeferencing (phase 1b applies it to localization).
"""

import csv
import json
import math
import os
import threading
import time

import numpy as np
import rospy
import yaml
import tf2_ros
from geometry_msgs.msg import TransformStamped
from nav_msgs.msg import Odometry
from sensor_msgs.msg import Imu, PointCloud2
from std_msgs.msg import Bool, String
from tf.transformations import (euler_from_matrix, euler_from_quaternion,
                                quaternion_matrix)
from ublox_msgs.msg import NavPVT
from vitulus_msgs.msg import Navi_transform

from vitulus_mapping.gates import GateConfig, InsertionGate


class InsertionGateNode:
    def __init__(self):
        self.map_frame = rospy.get_param('~map_frame', 'map')
        self.base_frame = rospy.get_param('~base_frame', 'base_link')
        self.cloud_topics = rospy.get_param(
            '~cloud_topics', ['/ground_cloud', '/obstacles_cloud'])
        self.max_rate_hz = float(rospy.get_param('~max_rate_hz', 3.0))
        self.output_dir = os.path.expanduser(rospy.get_param(
            '~output_dir', '~/.vitulus/mapping_v3/default'))

        cfg = GateConfig(
            mode=rospy.get_param('~mode', 'fused'),
            max_hacc_mm=rospy.get_param('~max_hacc_mm', 50.0),
            max_vacc_mm=rospy.get_param('~max_vacc_mm', 80.0),
            max_gps_age_s=rospy.get_param('~max_gps_age_s', 1.5),
            max_gps_odom_age_s=rospy.get_param('~max_gps_odom_age_s', 1.5),
            max_heading_diff_deg=rospy.get_param('~max_heading_diff_deg', 8.0),
            heading_offset_deg=rospy.get_param('~heading_offset_deg', 0.0),
            max_heading_age_s=rospy.get_param('~max_heading_age_s', 1.5),
            max_pose_age_s=rospy.get_param('~max_pose_age_s', 0.7),
            max_speed_mps=rospy.get_param('~max_speed_mps', 1.0),
            jump_margin_m=rospy.get_param('~jump_margin_m', 0.25),
            jump_cooldown_s=rospy.get_param('~jump_cooldown_s', 5.0),
            map_corr_xy_m=rospy.get_param('~map_corr_xy_m', 0.08),
            map_corr_yaw_deg=rospy.get_param('~map_corr_yaw_deg', 2.0),
            max_maporr_rate_mps=rospy.get_param('~max_maporr_rate_mps', 0.02),
            map_corr_window_s=rospy.get_param('~map_corr_window_s', 1.0),
        )
        self.gate = InsertionGate(cfg)

        self.tf_buf = tf2_ros.Buffer(rospy.Duration(10.0))
        self.tf_listener = tf2_ros.TransformListener(self.tf_buf)
        self.tf_bcast = tf2_ros.TransformBroadcaster()

        self.pub_cloud = rospy.Publisher('cloud_in', PointCloud2, queue_size=2)
        self.pub_gate = rospy.Publisher('gate', Bool, queue_size=1)
        self.pub_status = rospy.Publisher('gate_status', String,
                                          queue_size=1, latch=True)

        self.counters = {t: {'in': 0, 'out': 0} for t in self.cloud_topics}
        self.last_pub = {t: 0.0 for t in self.cloud_topics}
        self.last_alias_stamp = {}
        self.alias_lock = threading.Lock()   # cloud cbs run concurrently
        self.last_passed = None
        self.last_corrections = 0
        # georef capture state (phase 1a)
        self.georef_stable_s = float(rospy.get_param('~georef_stable_s', 5.0))
        self._georef_good_since = None
        self._georef_done = False
        self._last_latlon = None
        # --- continuous datum refinement (datumfix 2026-07-12) --------------
        # The one-shot early capture bakes in the residual dock-departure error
        # (pose just transitioned dock-DR -> GPS, before RTK settled). Measured
        # ~0.11 m backward on 2026-07-12. FIX: keep sampling utm->map for the
        # WHOLE session whenever the FULL localization is trustworthy (RTK FIXED
        # + gps_good + probation_proven, read from /nav_tf/loc_status), keep a
        # rolling buffer, and rewrite datum.yaml with a robust (median) estimate
        # at session stop. The early datum.yaml is still written first (so a
        # georef exists mid-session) but now also gated on probation_proven.
        self._loc = {}                       # latest /nav_tf/loc_status dict
        self._loc_t = 0.0
        self._datum_samples = []             # [(e, n, alt, yaw, z_corr), ...]
        self._datum_samples_max = int(rospy.get_param(
            '~datum_samples_max', 3000))     # ~50 min @ 1 Hz
        self._datum_lock = threading.Lock()
        self._georef_stop_written = False
        self._csv = None
        self._csv_writer = None
        self._open_csv()

        rospy.Subscriber('/gnss/navpvt', NavPVT, self.cb_navpvt, queue_size=2)
        rospy.Subscriber('/gnss_heading/navpvt', NavPVT,
                         self.cb_heading_navpvt, queue_size=2)
        rospy.Subscriber('/gnss_heading/nav_fused', Imu, self.cb_heading,
                         queue_size=2)
        rospy.Subscriber('/odometry/gps', Odometry, self.cb_gps_odom,
                         queue_size=2)
        rospy.Subscriber('/nav_tf/odom_status', Navi_transform,
                         self.cb_pose_src, queue_size=1)
        rospy.Subscriber('/nav_tf/loc_status', String, self.cb_loc_status,
                         queue_size=1)
        rospy.Subscriber('gate_mode', String, self.cb_mode, queue_size=1)
        for topic in self.cloud_topics:
            rospy.Subscriber(topic, PointCloud2, self.cb_cloud,
                             callback_args=topic, queue_size=1,
                             buff_size=2 ** 22)

        rospy.Timer(rospy.Duration(0.2), self.tick_gate)
        rospy.Timer(rospy.Duration(1.0), self.tick_status)
        rospy.loginfo('insertion_gate up: mode=%s clouds=%s -> %s',
                      cfg.mode, self.cloud_topics,
                      rospy.resolve_name('cloud_in'))

    # ---- sensor feeds -------------------------------------------------------
    def cb_navpvt(self, msg):
        self.gate.feed_navpvt(rospy.Time.now().to_sec(), msg.flags,
                              msg.hAcc, msg.vAcc)
        self._last_latlon = (msg.lat * 1e-7, msg.lon * 1e-7)

    def cb_heading_navpvt(self, msg):
        self.gate.feed_heading_navpvt(rospy.Time.now().to_sec(), msg.flags)

    def cb_heading(self, msg):
        q = msg.orientation
        yaw = euler_from_quaternion([q.x, q.y, q.z, q.w])[2]
        self.gate.feed_heading(msg.header.stamp.to_sec(), yaw)

    def cb_gps_odom(self, msg):
        p = msg.pose.pose.position
        self.gate.feed_gps_odom(msg.header.stamp.to_sec(), p.x, p.y, p.z)

    def cb_pose_src(self, msg):
        self.gate.feed_pose_src(rospy.Time.now().to_sec(), msg.status)

    def cb_loc_status(self, msg):
        """navi_transform's authoritative localization health (JSON): owner,
        gps_good, probation_proven, docked. Used to gate datum refinement on
        the FULL arbiter state, not just raw RTK carrier quality."""
        try:
            self._loc = json.loads(msg.data)
            self._loc_t = time.monotonic()
        except (ValueError, TypeError):
            pass

    def _loc_trustworthy(self):
        """True when navi_transform reports GPS ownership fully proven and
        fresh — the precondition for capturing/refining the site datum."""
        if not self._loc or (time.monotonic() - self._loc_t) > 3.0:
            return False
        return bool(self._loc.get('gps_good')
                    and self._loc.get('probation_proven')
                    and not self._loc.get('docked'))

    def cb_mode(self, msg):
        mode = msg.data.strip()
        if mode not in ('fused', 'rtk', 'force_on', 'off'):
            rospy.logwarn('insertion_gate: unknown mode %r', mode)
            return
        self.gate.cfg.mode = mode
        rospy.logwarn('insertion_gate: mode -> %s', mode)

    def sample_pose(self):
        try:
            tr = self.tf_buf.lookup_transform(self.map_frame, self.base_frame,
                                              rospy.Time(0), rospy.Duration(0.05))
        except (tf2_ros.LookupException, tf2_ros.ConnectivityException,
                tf2_ros.ExtrapolationException):
            return
        t = tr.transform.translation
        q = tr.transform.rotation
        yaw = euler_from_quaternion([q.x, q.y, q.z, q.w])[2]
        self.gate.feed_pose(tr.header.stamp.to_sec(), t.x, t.y, t.z, yaw)
        try:
            mo = self.tf_buf.lookup_transform(self.map_frame, 'odom',
                                              rospy.Time(0),
                                              rospy.Duration(0.05))
        except (tf2_ros.LookupException, tf2_ros.ConnectivityException,
                tf2_ros.ExtrapolationException):
            return
        mt = mo.transform.translation
        mq = mo.transform.rotation
        myaw = euler_from_quaternion([mq.x, mq.y, mq.z, mq.w])[2]
        self.gate.feed_map_odom(rospy.Time.now().to_sec(), mt.x, mt.y, myaw)
        if self.gate.corrections != self.last_corrections:
            rospy.logwarn('insertion_gate: localization correction #%d '
                          'detected (map->odom step) — insertion paused %.0fs',
                          self.gate.corrections, self.gate.cfg.jump_cooldown_s)
            self.last_corrections = self.gate.corrections

    # ---- gate ticks ---------------------------------------------------------
    def tick_gate(self, _evt):
        self.sample_pose()
        dec = self.gate.evaluate(rospy.Time.now().to_sec())
        self.pub_gate.publish(Bool(dec.passed))
        if dec.passed != self.last_passed:
            (rospy.loginfo if dec.passed else rospy.logwarn)(
                'insertion_gate: %s %s',
                'OPEN' if dec.passed else 'CLOSED', dec.reasons)
            self.last_passed = dec.passed
        self._last_decision = dec

    def tick_status(self, _evt):
        dec = getattr(self, '_last_decision', None)
        if dec is None:
            return
        status = {'pass': dec.passed, 'reasons': dec.reasons,
                  'z_corr_m': round(self.gate.z_correction(), 3),
                  'counters': self.counters}
        status.update(dec.info)
        self.pub_status.publish(String(json.dumps(status)))
        self.try_capture_georef(dec)

    # ---- site georeference capture (POSE_DATUM_PLAN phase 1a) ---------------
    def _sample_utm_map(self):
        """Return (e, n, alt, yaw) of the site (map) frame origin in UTM, or
        None if TF not ready. utm->map = utm->odom o inv(map->odom)."""
        try:
            t_uo = self.tf_buf.lookup_transform('utm', 'odom', rospy.Time(0),
                                                rospy.Duration(0.1))
            t_mo = self.tf_buf.lookup_transform(self.map_frame, 'odom',
                                                rospy.Time(0),
                                                rospy.Duration(0.1))
        except (tf2_ros.LookupException, tf2_ros.ConnectivityException,
                tf2_ros.ExtrapolationException):
            return None                  # navsat/utm not up yet — keep waiting

        def to_mat(tr):
            q = tr.transform.rotation
            t = tr.transform.translation
            m = quaternion_matrix([q.x, q.y, q.z, q.w])
            m[0:3, 3] = [t.x, t.y, t.z]
            return m

        m_um = to_mat(t_uo) @ np.linalg.inv(to_mat(t_mo))
        e, n, alt = m_um[0:3, 3]
        yaw = euler_from_matrix(m_um)[2]
        return float(e), float(n), float(alt), float(yaw)

    def _build_datum(self, e, n, alt, yaw, nsamples=1):
        """Assemble a datum dict (with lat/lon back-projection) for writing."""
        datum = {
            'utm_e': float(round(e, 3)), 'utm_n': float(round(n, 3)),
            'alt': float(round(alt, 3)),
            'yaw_rad': float(round(yaw, 6)),
            'z_corr_m': round(self.gate.z_correction(), 3),
            'captured': time.strftime('%Y-%m-%d %H:%M:%S'),
            'n_samples': int(nsamples),
            'version': 2,
        }
        if self._last_latlon is not None:
            datum['robot_lat'] = round(self._last_latlon[0], 8)
            datum['robot_lon'] = round(self._last_latlon[1], 8)
            try:
                from pyproj import CRS, Transformer
                zone = int((self._last_latlon[1] + 180) // 6) + 1
                crs = CRS.from_dict({'proj': 'utm', 'zone': zone,
                                     'ellps': 'WGS84'})
                tr = Transformer.from_crs(crs, 'EPSG:4326', always_xy=True)
                lon0, lat0 = tr.transform(e, n)
                datum.update({'utm_zone': zone,
                              'origin_lat': round(lat0, 8),
                              'origin_lon': round(lon0, 8)})
            except Exception:
                pass
        return datum

    def try_capture_georef(self, dec):
        """Called at 1 Hz. Two jobs:
          (1) continuously accumulate utm->map samples whenever navi_transform
              reports GPS ownership fully proven (gps_good + probation_proven),
              so the STOP path can write a robust median datum; and
          (2) write the EARLY datum.yaml once (so a georef exists mid-session)
              — now also gated on probation_proven, preventing the residual
              dock-departure error from baking into even the first value.
        """
        now = time.monotonic()
        # Trust the full arbiter (loc_status). Fall back to raw RTK-fixed
        # quality only if loc_status is absent (older navi_transform).
        if self._loc:
            trustworthy = self._loc_trustworthy()
        else:
            flags = dec.info.get('quality_flags', dec.reasons)
            trustworthy = (dec.passed or dec.info.get('mode') == 'fused') \
                and not flags and bool(dec.info.get('rtk_fixed'))

        if not trustworthy:
            self._georef_good_since = None
            return

        sample = self._sample_utm_map()
        if sample is None:
            return                       # TF not ready — do not start the clock
        e, n, alt, yaw = sample

        # (1) accumulate for the robust stop-time estimate
        with self._datum_lock:
            self._datum_samples.append((e, n, alt, yaw,
                                        self.gate.z_correction()))
            if len(self._datum_samples) > self._datum_samples_max:
                # keep the most recent window (settled localization)
                self._datum_samples = \
                    self._datum_samples[-self._datum_samples_max:]

        # (2) early one-shot datum.yaml (still needed mid-session)
        if self._georef_done:
            return
        if self._georef_good_since is None:
            self._georef_good_since = now
            return
        if now - self._georef_good_since < self.georef_stable_s:
            return

        datum = self._build_datum(e, n, alt, yaw)
        session_path = os.path.join(
            self.output_dir, time.strftime('datum_session_%Y%m%d_%H%M%S.yaml'))
        with open(session_path, 'w') as f:
            yaml.safe_dump(datum, f, default_flow_style=False, sort_keys=False)
        datum_path = os.path.join(self.output_dir, 'datum.yaml')
        if not os.path.exists(datum_path):
            with open(datum_path, 'w') as f:
                yaml.safe_dump(datum, f, default_flow_style=False,
                               sort_keys=False)
            rospy.logwarn('insertion_gate: site georeference CAPTURED (early) '
                          '-> %s (utm %.2f, %.2f, alt %.2f, yaw %.2f deg); '
                          'will refine at session stop',
                          datum_path, e, n, alt, math.degrees(yaw))
        else:
            rospy.loginfo('insertion_gate: session georef logged -> %s',
                          session_path)
        self._georef_done = True

    def finalize_georef(self):
        """At session shutdown, rewrite datum.yaml with a ROBUST estimate
        (median over all trustworthy samples collected during the drive),
        correcting the early-capture dock-departure residual. Idempotent."""
        if self._georef_stop_written:
            return
        with self._datum_lock:
            samples = list(self._datum_samples)
        if not samples:
            rospy.logwarn('insertion_gate: finalize_georef: no trustworthy '
                          'utm->map samples collected — leaving datum.yaml '
                          '(early capture) unchanged')
            return
        self._georef_stop_written = True
        arr = np.array([(e, n, alt, yaw) for (e, n, alt, yaw, _z) in samples],
                       dtype=float)
        # circular median for yaw (values cluster near 0; wrap-safe)
        med = np.median(arr, axis=0)
        e, n, alt = med[0], med[1], med[2]
        yaws = arr[:, 3]
        yaw = math.atan2(float(np.median(np.sin(yaws))),
                         float(np.median(np.cos(yaws))))
        datum = self._build_datum(e, n, alt, yaw, nsamples=len(samples))

        datum_path = os.path.join(self.output_dir, 'datum.yaml')
        old = None
        try:
            with open(datum_path) as f:
                old = yaml.safe_load(f)
        except Exception:
            pass
        with open(datum_path, 'w') as f:
            yaml.safe_dump(datum, f, default_flow_style=False, sort_keys=False)
        # also archive as the definitive session datum
        final_path = os.path.join(
            self.output_dir, time.strftime('datum_final_%Y%m%d_%H%M%S.yaml'))
        with open(final_path, 'w') as f:
            yaml.safe_dump(datum, f, default_flow_style=False, sort_keys=False)

        if old and 'utm_e' in old:
            de = e - float(old['utm_e'])
            dn = n - float(old['utm_n'])
            delta = math.hypot(de, dn)
            rospy.logwarn('insertion_gate: site georeference REFINED at stop '
                          '(%d samples): utm %.3f, %.3f (delta from early '
                          '%.3f, %.3f | %.3f m), yaw %.3f deg -> %s',
                          len(samples), e, n, de, dn, delta,
                          math.degrees(yaw), datum_path)
            # STEP 2d: the "docked" waypoint lives in the navi map pickle in
            # MAP-frame coords under the OLD datum. After a meaningful datum
            # shift, the GPS-world <-> map alignment moved; re-save "docked"
            # once while docked + well-localized so the dock seed and RTK agree.
            if delta > 0.05:
                rospy.logwarn(
                    'insertion_gate: datum moved %.3f m — recommend re-saving '
                    'the "docked" waypoint once while docked & well-localized: '
                    'rostopic pub -1 /navi_manager/save_waypoint std_msgs/String '
                    '"data: \'docked\'"', delta)
        else:
            rospy.logwarn('insertion_gate: site georeference WRITTEN at stop '
                          '(%d samples): utm %.3f, %.3f -> %s',
                          len(samples), e, n, datum_path)

    # ---- cloud path ---------------------------------------------------------
    def cb_cloud(self, msg, topic):
        self.counters[topic]['in'] += 1
        now = time.monotonic()
        if now - self.last_pub[topic] < 1.0 / self.max_rate_hz:
            return
        dec = getattr(self, '_last_decision', None)
        if dec is None:
            return
        self.log_decision(msg, topic, dec)
        if not dec.passed:
            return

        alias = msg.header.frame_id + '_mapping'
        with self.alias_lock:
            need_tf = self.last_alias_stamp.get(alias) != msg.header.stamp.to_nsec()
            if need_tf:
                self.last_alias_stamp[alias] = msg.header.stamp.to_nsec()
        if need_tf:
            try:
                tr = self.tf_buf.lookup_transform(
                    self.map_frame, msg.header.frame_id,
                    msg.header.stamp, rospy.Duration(0.2))
            except (tf2_ros.LookupException, tf2_ros.ConnectivityException,
                    tf2_ros.ExtrapolationException) as e:
                rospy.logwarn_throttle(10.0, 'insertion_gate: TF for cloud '
                                       'failed: %s', e)
                return
            out = TransformStamped()
            out.header.stamp = msg.header.stamp
            out.header.frame_id = self.map_frame
            out.child_frame_id = alias
            out.transform = tr.transform
            out.transform.translation.z += self.gate.z_correction()
            self.tf_bcast.sendTransform(out)

        gated = PointCloud2()
        gated.header.stamp = msg.header.stamp
        gated.header.frame_id = alias
        gated.height = msg.height
        gated.width = msg.width
        gated.fields = msg.fields
        gated.is_bigendian = msg.is_bigendian
        gated.point_step = msg.point_step
        gated.row_step = msg.row_step
        gated.data = msg.data
        gated.is_dense = msg.is_dense
        self.pub_cloud.publish(gated)
        self.last_pub[topic] = now
        self.counters[topic]['out'] += 1

    # ---- logging ------------------------------------------------------------
    def _open_csv(self):
        logdir = os.path.join(self.output_dir, 'logs')
        os.makedirs(logdir, exist_ok=True)
        path = os.path.join(logdir, time.strftime('gate_%Y%m%d_%H%M%S.csv'))
        self._csv = open(path, 'w', newline='')
        self._csv_writer = csv.writer(self._csv)
        self._csv_writer.writerow(
            ['stamp', 'topic', 'pass', 'reasons', 'mode', 'pose_src',
             'rtk_fixed', 'hacc_mm', 'vacc_mm', 'heading_diff_deg',
             'z_source', 'z_corr_m', 'map_corrections', 'map_corr_rate_mmps'])
        rospy.loginfo('insertion_gate: decision log %s', path)

    def log_decision(self, msg, topic, dec):
        i = dec.info
        self._csv_writer.writerow(
            [f'{msg.header.stamp.to_sec():.3f}', topic, int(dec.passed),
             '|'.join(dec.reasons), i.get('mode', ''), i.get('pose_src', ''),
             i.get('rtk_fixed', ''), i.get('hacc_mm', ''),
             i.get('vacc_mm', ''), i.get('heading_diff_deg', ''),
             i.get('z_source', ''), round(self.gate.z_correction(), 3),
             i.get('map_corrections', 0), i.get('map_corr_rate_mmps', '')])
        self._csv.flush()


if __name__ == '__main__':
    rospy.init_node('insertion_gate')
    node = InsertionGateNode()
    # Refine + rewrite datum.yaml with the robust median estimate when the
    # mapping session stops (SIGINT from roslaunch / mapping_manager). This is
    # the fix for the early-capture dock-departure error.
    rospy.on_shutdown(node.finalize_georef)
    rospy.spin()
