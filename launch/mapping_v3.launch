<launch>
  <!-- Mapping v3: mapping with known poses, runs ALONGSIDE the current stack.
       Zero writes outside /mapping/*.
       site            .. per-garden data directory name
       octomap         .. master switch (bool, default true) for the legacy
                          octomap/band raster chain (2026-07-19). true keeps
                          octomap_server + its projected_map throttle +
                          band_projector. false = DIRECT-RASTER-ONLY: none of
                          those three start, and direct_raster (2D log-odds
                          straight from the clouds) is the sole mapper.
                          insertion_gate / trajectory_dem / direct_raster are
                          unaffected either way. mapping_manager passes
                          octomap:=false for sites whose site_config.json has
                          {"octomap": false}.
       octomap_archive .. optional path to a previously saved .ot to CONTINUE
                          from (only consumed when octomap:=true). Was formerly
                          the 'octomap' arg; renamed so 'octomap' is the on/off
                          switch requested tonight.
       resolution      .. per-site voxel/raster resolution in metres (M13).
                          Default 0.05 keeps 'garden'; mapping_manager passes a
                          per-site value from <site>/site_config.json when
                          present. Overrides the config-file resolution on
                          octomap_server + trajectory_dem. -->
  <arg name="site" default="default"/>
  <arg name="output_dir" default="$(env HOME)/.vitulus/mapping_v3/$(arg site)"/>
  <arg name="octomap" default="true"/>
  <arg name="octomap_archive" default=""/>
  <arg name="resolution" default="0.05"/>

  <group ns="mapping">
    <rosparam command="load" file="$(find vitulus_mapping)/config/mapping_v3.yaml"/>

    <!-- Legacy octomap/band raster chain — skipped entirely when octomap:=false
         (direct-raster-only sessions, e.g. zahrada3). -->
    <group if="$(arg octomap)">
      <node pkg="octomap_server" type="octomap_server_node" name="octomap_server"
            output="screen" args="$(arg octomap_archive)">
        <!-- M13: overrides the config-file resolution (later param wins). -->
        <param name="resolution" value="$(arg resolution)"/>
      </node>

      <!-- 2D projection throttled for the web UI 3D view (rosbridge-friendly).
           Consumes octomap's projected_map, so it lives inside this group. -->
      <node pkg="topic_tools" type="throttle" name="projected_map_throttle"
            args="messages projected_map 0.5 projected_map_slow"/>

      <node pkg="vitulus_mapping" type="band_projector" name="band_projector"
            output="screen">
        <param name="output_dir" value="$(arg output_dir)"/>
      </node>
    </group>

    <node pkg="vitulus_mapping" type="insertion_gate" name="insertion_gate"
          output="screen">
      <param name="output_dir" value="$(arg output_dir)"/>
    </node>

    <node pkg="vitulus_mapping" type="trajectory_dem" name="trajectory_dem"
          output="screen">
      <param name="output_dir" value="$(arg output_dir)"/>
      <param name="resolution" value="$(arg resolution)"/>
    </node>

    <!-- Direct 2D raster mapper (2026-07-19): builds an OccupancyGrid straight
         from the per-frame segmented clouds (lidar + rtabmap obstacle/ground),
         discarding absolute z, so it is immune to the global pose-z drift that
         plagues the octomap/band chain. With octomap:=false it is the SOLE
         mapper; with octomap:=true it runs ALONGSIDE band_projector (A/B).
         ~direct_enabled=false disables it cleanly. Same per-site resolution. -->
    <node pkg="vitulus_mapping" type="direct_raster" name="direct_raster"
          output="screen">
      <param name="output_dir" value="$(arg output_dir)"/>
      <param name="resolution" value="$(arg resolution)"/>
    </node>
  </group>
</launch>
